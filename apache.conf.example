# Configuration Apache pour Blazor avec SignalR
# À placer dans /etc/apache2/sites-available/bridgerton-birthday.fr.conf

# Activer les modules nécessaires :
# sudo a2enmod proxy
# sudo a2enmod proxy_http
# sudo a2enmod proxy_wstunnel
# sudo a2enmod ssl
# sudo a2enmod headers
# sudo a2enmod rewrite

<VirtualHost *:80>
    ServerName bridgerton-birthday.fr
    ServerAlias www.bridgerton-birthday.fr
    
    # Redirection HTTP vers HTTPS
    Redirect permanent / https://bridgerton-birthday.fr/
</VirtualHost>

<VirtualHost *:443>
    ServerName bridgerton-birthday.fr
    ServerAlias www.bridgerton-birthday.fr

    # Certificats SSL (à configurer avec Certbot/Let's Encrypt)
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/bridgerton-birthday.fr/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/bridgerton-birthday.fr/privkey.pem

    # Configuration SSL recommandée
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite HIGH:!aNULL:!MD5

    # Logs
    ErrorLog ${APACHE_LOG_DIR}/bridgerton-birthday_error.log
    CustomLog ${APACHE_LOG_DIR}/bridgerton-birthday_access.log combined

    # Configuration WebSocket pour SignalR
    # IMPORTANT : Les locations WebSocket doivent être AVANT le ProxyPass général
    
    # NotificationHub WebSocket
    <Location "/notificationHub">
        ProxyPass "ws://localhost:5000/notificationHub"
        ProxyPassReverse "ws://localhost:5000/notificationHub"
        
        # Headers WebSocket
        RewriteEngine On
        RewriteCond %{HTTP:Upgrade} =websocket [NC]
        RewriteRule /(.*) ws://localhost:5000/$1 [P,L]
        RewriteCond %{HTTP:Upgrade} !=websocket [NC]
        RewriteRule /(.*) http://localhost:5000/$1 [P,L]
        
        ProxyPreserveHost On
        ProxyTimeout 86400
    </Location>

    # ChatHub WebSocket
    <Location "/chatHub">
        ProxyPass "ws://localhost:5000/chatHub"
        ProxyPassReverse "ws://localhost:5000/chatHub"
        
        # Headers WebSocket
        RewriteEngine On
        RewriteCond %{HTTP:Upgrade} =websocket [NC]
        RewriteRule /(.*) ws://localhost:5000/$1 [P,L]
        RewriteCond %{HTTP:Upgrade} !=websocket [NC]
        RewriteRule /(.*) http://localhost:5000/$1 [P,L]
        
        ProxyPreserveHost On
        ProxyTimeout 86400
    </Location>

    # API REST
    <Location "/api">
        ProxyPass "http://localhost:5000/api"
        ProxyPassReverse "http://localhost:5000/api"
        ProxyPreserveHost On
    </Location>

    # Application principale
    ProxyPass "/" "http://localhost:5000/"
    ProxyPassReverse "/" "http://localhost:5000/"
    ProxyPreserveHost On

    # Headers pour proxy
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # Cache pour fichiers statiques
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</VirtualHost>
