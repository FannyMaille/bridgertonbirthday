@using BridgertonGame.Shared.Models

<div class="notification-bell" @onclick="TogglePanel">
    <div class="bell-icon">🔔</div>
    @if (unreadCount > 0)
    {
        <div class="notification-badge">@unreadCount</div>
    }
</div>

@if (isPanelOpen)
{
    <div class="notification-panel-overlay" @onclick="ClosePanel"></div>
    <div class="notification-panel">
        <div class="notification-header">
            <h3>Notifications</h3>
            <div class="notification-actions">
                @if (!pushEnabled)
                {
                    <button class="enable-push-btn" @onclick="EnablePushNotifications" title="Activer notifications push">
                        🔔
                    </button>
                }
                @if (notifications.Any())
                {
                    <button class="mark-all-btn" @onclick="MarkAllAsRead" title="Tout marquer comme lu">
                        ✓
                    </button>
                    <button class="clear-all-btn" @onclick="ClearAll" title="Tout effacer">
                        🗑️
                    </button>
                }
                <button class="close-panel-btn" @onclick="ClosePanel">✕</button>
            </div>
        </div>
        
        <div class="notification-list">
            @if (!notifications.Any())
            {
                <div class="no-notifications">
                    <div class="empty-icon">📭</div>
                    <p>Aucune notification</p>
                </div>
            }
            else
            {
                @foreach (var notification in notifications)
                {
                    <div class="notification-item @GetNotificationClass(notification)" @onclick="() => OnNotificationClick(notification)">
                        <div class="notification-icon">@GetNotificationIcon(notification.Type)</div>
                        <div class="notification-content">
                            <div class="notification-title">@notification.Title</div>
                            <div class="notification-message">@notification.Message</div>
                            <div class="notification-time">@FormatTime(notification.CreatedAt)</div>
                        </div>
                        <button class="notification-close" @onclick="() => ClearNotification(notification.Id)" @onclick:stopPropagation="true">
                            ✕
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}
