@page "/classement"
@using BridgertonGame.Client.Shared
@using BridgertonGame.Shared.Models

<PageTitle>Classement - The Bridgerton Game</PageTitle>

<Header />

<Hero TitlePrefix="THE" Title="Classement" BackgroundImage="images/hero-classement.jpg" />

<main class="main-content">
    @if (families == null || gameScores == null)
    {
        <p>Chargement...</p>
    }
    else
    {
        <!-- Section Classement Moderne -->
        <div class="modern-ranking-section">
            <div class="ranking-cards-container">
                @foreach (var entry in GetCompleteRanking())
                {
                    <div class="ranking-card @GetRankingCardClass(entry.Rank) @(entry.IsLadyWhistledownTeam ? "lady-whistledown-team-card" : "")">
                        @if (entry.Rank == 1)
                        {
                            <div class="crown-decoration">
                                <img src="images/Crown.png" alt="Crown" />
                            </div>
                        }
                        <div class="ranking-card-inner">
                            <div class="rank-badge @(entry.IsLadyWhistledownTeam ? "rank-badge-whistledown" : "")">
                                <span class="rank-number">@GetRankText(entry.Rank)</span>
                            </div>
                            <div class="family-info">
                                @if (entry.IsLadyWhistledownTeam)
                                {
                                    <span class="family-label" style="color: #f093fb;">👥 Équipe</span>
                                    <span class="family-name-text" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Lady Whistledown</span>
                                }
                                else
                                {
                                    <span class="family-label">Famille</span>
                                    <span class="family-name-text">@entry.Name</span>
                                }
                            </div>
                            <div class="points-badge @(entry.IsLadyWhistledownTeam ? "points-badge-whistledown" : "")">
                                <span class="points-value">@entry.Points</span>
                                <span class="points-label">pts</span>
                            </div>
                        </div>
                        @if (entry.IsLadyWhistledownTeam)
                        {
                            <div style="text-align: center; margin-top: 10px; font-size: 0.85rem; opacity: 0.8; font-style: italic;">
                                📰 Publications uniquement
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="section-divider">
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
            <h3>Tableau des<br/>Points</h3>
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
        </div>

        <div class="modern-points-table">
            <div class="table-scroll-container">
                <table class="points-table-modern">
                    <thead>
                        <tr>
                            <th class="game-column">Jeu</th>
                            @foreach (var family in families)
                            {
                                <th class="family-column">@family.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gameScore in gameScores)
                        {
                            <tr class="@GetRowClass(gameScore.GameName)">
                                <td class="game-name-cell">@gameScore.GameName</td>
                                @foreach (var family in families)
                                {
                                    var score = gameScore.FamilyScores.ContainsKey(family.Id) ? gameScore.FamilyScores[family.Id] : 0;
                                    <td class="score-cell @(score < 0 ? "negative-score" : score > 0 ? "positive-score" : "")">
                                        <span class="score-value">@FormatScore(score)</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="section-divider">
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
            <h3>Lady<br/>Whistledown</h3>
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
        </div>

        <div class="characters-grid-modern">
            @foreach (var rankedFamily in GetRankedWhistledowns())
            {
                var family = rankedFamily.Family;
                var rank = rankedFamily.Rank;
                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                var articleCount = articles?.Count(a => a.FamilyId == family.Id) ?? 0;
                var points = GetPlayerPoints(family.Id);
                var voteResult = voteResults?.FirstOrDefault(vr => vr.FamilyId == family.Id);
                
                <div class="character-card-modern reveal-card-wrapper @GetWhistledownRankClass(rank)">
                    @if (rank == 1 && (family.Revealed || points > 0))
                    {
                        <div class="crown-decoration">
                            <img src="images/Crown.png" alt="Crown" />
                        </div>
                    }
                    <div class="character-card-inner">
                        <div class="rank-badge-whistledown">
                            <span class="rank-number">@GetRankText(rank)</span>
                        </div>
                        <div class="character-image-wrapper-large">
                            @if (family.Revealed && ladyWhistledown != null)
                            {
                                <img src="@ladyWhistledown.ImageUrl" alt="@ladyWhistledown.Name" class="character-image-large" @onclick="() => ShowImageModal(ladyWhistledown.ImageUrl)" />
                            }
                            else
                            {
                                <img src="images/LadyWithldown.png" alt="Mystery" class="character-image-large mystery-silhouette-large" />
                            }
                        </div>
                        <div class="character-info-modern">
                            <div class="character-title-text">FAMILLE @family.Name</div>
                            @if (family.Revealed && ladyWhistledown != null)
                            {
                                <div class="character-name-text">@ladyWhistledown.Name</div>
                                <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; flex-wrap: wrap;">
                                    <div style="padding: 8px 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 20px; display: inline-block;">
                                        <strong>@points pts</strong>
                                    </div>
                                </div>
                                @if (articleCount > 0)
                                {
                                    <div style="margin-top: 8px; padding: 6px 12px; background: rgba(102, 126, 234, 0.2); color: #667eea; border-radius: 15px; display: inline-block; font-size: 0.9rem;">
                                        📰 <strong>@articleCount article@(articleCount > 1 ? "s" : "")</strong>
                                    </div>
                                }
                                
                                @* Afficher les résultats des votes si révélé *@
                                @if (voteResult != null && voteResult.IsRevealed && voteResult.Votes.Any())
                                {
                                    <div style="margin-top: 15px; padding: 12px; background: rgba(255, 255, 255, 0.9); border-radius: 10px; width: 100%;">
                                        <div style="font-weight: 600; margin-bottom: 8px; color: #2c3e50; font-size: 0.95rem;">
                                            🗳️ Résultats des votes
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                                            <div style="text-align: center; padding: 6px; background: #d4edda; border-radius: 5px;">
                                                <div style="font-size: 1.2rem; font-weight: bold; color: #28a745;">@voteResult.TotalCorrectVotes</div>
                                                <div style="font-size: 0.75rem; color: #155724;">Corrects</div>
                                            </div>
                                            <div style="text-align: center; padding: 6px; background: #f8d7da; border-radius: 5px;">
                                                <div style="font-size: 1.2rem; font-weight: bold; color: #dc3545;">@voteResult.TotalIncorrectVotes</div>
                                                <div style="font-size: 0.75rem; color: #721c24;">Incorrects</div>
                                            </div>
                                        </div>
                                        
                                        @* Détails de l'impact des votes *@
                                        <div style="background: rgba(245, 247, 250, 0.8); border-radius: 8px; padding: 10px; margin-bottom: 8px;">
                                            <div style="font-size: 0.85rem; color: #2c3e50; margin-bottom: 6px; font-weight: 500;">
                                                Impact des votes :
                                            </div>
                                            <div style="display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem;">
                                                @if (voteResult.TotalCorrectVotes > 0)
                                                {
                                                    <div style="color: #28a745;">
                                                        ✓ @voteResult.TotalCorrectVotes vote@(voteResult.TotalCorrectVotes > 1 ? "s" : "") correct@(voteResult.TotalCorrectVotes > 1 ? "s" : "") 
                                                        → <strong>+@(voteResult.TotalCorrectVotes * 10)pts</strong> aux équipes
                                                    </div>
                                                }
                                                @if (voteResult.TotalIncorrectVotes > 0)
                                                {
                                                    <div style="color: #dc3545;">
                                                        ✗ @voteResult.TotalIncorrectVotes vote@(voteResult.TotalIncorrectVotes > 1 ? "s" : "") incorrect@(voteResult.TotalIncorrectVotes > 1 ? "s" : "") 
                                                        → <strong>-@(voteResult.TotalIncorrectVotes * 10)pts</strong> aux équipes
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        
                                        @* Points totaux pour Lady Whistledown *@
                                        <div style="text-align: center; padding: 10px; background: @(voteResult.TotalPointsAwarded >= 0 ? "rgba(245, 87, 108, 0.1)" : "rgba(102, 126, 234, 0.1)"); border: 2px solid @(voteResult.TotalPointsAwarded >= 0 ? "#f5576c" : "#667eea"); border-radius: 8px;">
                                            <div style="font-size: 0.75rem; color: #2c3e50; margin-bottom: 4px; font-weight: 500;">
                                                Points Lady Whistledown
                                            </div>
                                            <div style="font-weight: bold; font-size: 1.1rem; color: @(voteResult.TotalPointsAwarded >= 0 ? "#f5576c" : "#667eea");">
                                                @(voteResult.TotalPointsAwarded > 0 ? "+" : "")@voteResult.TotalPointsAwarded pts
                                            </div>
                                            <div style="font-size: 0.7rem; color: #666; margin-top: 2px; font-style: italic;">
                                                @if (voteResult.TotalPointsAwarded > 0)
                                                {
                                                    <span>Bénéfice des votes incorrects</span>
                                                }
                                                else if (voteResult.TotalPointsAwarded < 0)
                                                {
                                                    <span>Pénalité des votes corrects</span>
                                                }
                                                else
                                                {
                                                    <span>Équilibre parfait</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="character-name-text mystery-name">???</div>
                                @if (ladyWhistledown != null && !family.Revealed)
                                {
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; flex-wrap: wrap;">
                                        <div style="padding: 8px 15px; background: rgba(113, 114, 197, 0.3); color: #333; border-radius: 20px; display: inline-block;">
                                            <strong>@points pts</strong>
                                        </div>
                                    </div>
                                    @if (articleCount > 0)
                                    {
                                        <div style="margin-top: 8px; padding: 6px 12px; background: rgba(113, 114, 197, 0.15); color: #555; border-radius: 15px; display: inline-block; font-size: 0.9rem;">
                                            📰 <strong>@articleCount article@(articleCount > 1 ? "s" : "")</strong>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showModal)
    {
        <div class="image-modal-overlay" @onclick="CloseImageModal">
            <div class="image-modal-container" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseImageModal">✕</button>
                <img src="@selectedImage" alt="Agrandir" class="modal-image" />
            </div>
        </div>
    }
</main>
