@page "/classement"
@using BridgertonGame.Client.Shared
@using BridgertonGame.Shared.Models
@inject ApiService ApiService

<PageTitle>Classement - The Bridgerton Game</PageTitle>

<Header />

<Hero TitlePrefix="THE" Title="Classement" BackgroundImage="images/hero-classement.jpg" />

<main class="main-content">
    @if (families == null || gameScores == null)
    {
        <p>Chargement...</p>
    }
    else
    {
        <!-- Section Classement Moderne -->
        <div class="modern-ranking-section">
            <div class="ranking-cards-container">
                @foreach (var family in families.OrderBy(f => f.Rank))
                {
                    <div class="ranking-card @GetRankingCardClass(family.Rank)">
                        @if (family.Rank == 1)
                        {
                            <div class="crown-decoration">
                                <img src="images/Crown.png" alt="Crown" />
                            </div>
                        }
                        <div class="ranking-card-inner">
                            <div class="rank-badge">
                                <span class="rank-number">@GetRankText(family.Rank)</span>
                            </div>
                            <div class="family-info">
                                <span class="family-label">Famille</span>
                                <span class="family-name-text">@family.Name</span>
                            </div>
                            <div class="points-badge">
                                <span class="points-value">@family.Points</span>
                                <span class="points-label">pts</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="section-divider">
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
            <h3>Tableau des<br/>Points</h3>
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
        </div>

        <div class="modern-points-table">
            <div class="table-scroll-container">
                <table class="points-table-modern">
                    <thead>
                        <tr>
                            <th class="game-column">Jeu</th>
                            @foreach (var family in families)
                            {
                                <th class="family-column">@family.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gameScore in gameScores)
                        {
                            <tr class="@(gameScore.GameName == "Total" ? "total-row" : gameScore.GameName == "Whistledown" ? "whistledown-row" : "")">
                                <td class="game-name-cell">@gameScore.GameName</td>
                                @foreach (var family in families)
                                {
                                    var score = gameScore.FamilyScores.ContainsKey(family.Id) ? gameScore.FamilyScores[family.Id] : 0;
                                    <td class="score-cell @(score < 0 ? "negative-score" : score > 0 ? "positive-score" : "")">
                                        <span class="score-value">@FormatScore(score)</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="section-divider">
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
            <h3>Lady<br/>Whistledown</h3>
            <div class="flower-line">
                <img src="images/Ornement.png" alt="" />
            </div>
        </div>

        <div class="characters-grid-modern">
            @foreach (var family in families)
            {
                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                
                <div class="character-card-modern reveal-card-wrapper">
                    <div class="character-card-inner">
                        <div class="character-image-wrapper-large">
                            @if (family.Revealed && ladyWhistledown != null)
                            {
                                <img src="@ladyWhistledown.ImageUrl" alt="@ladyWhistledown.Name" class="character-image-large" @onclick="() => ShowImageModal(ladyWhistledown.ImageUrl)" />
                            }
                            else
                            {
                                <img src="images/LadyWithldown.png" alt="Mystery" class="character-image-large mystery-silhouette-large" />
                            }
                        </div>
                        <div class="character-info-modern">
                            <div class="character-title-text">FAMILLE @family.Name</div>
                            @if (family.Revealed && ladyWhistledown != null)
                            {
                                <div class="character-name-text">@ladyWhistledown.Name</div>
                            }
                            else
                            {
                                <div class="character-name-text mystery-name">???</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showModal)
    {
        <div class="image-modal-overlay" @onclick="CloseImageModal">
            <div class="image-modal-container" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseImageModal">✕</button>
                <img src="@selectedImage" alt="Agrandir" class="modal-image" />
            </div>
        </div>
    }
</main>

@code {
    private List<Family>? families;
    private List<GameScore>? gameScores;
    private List<Player>? players;
    private bool showModal = false;
    private string selectedImage = "";

    protected override async Task OnInitializedAsync()
    {
        families = await ApiService.GetAllFamiliesAsync();
        gameScores = await ApiService.GetAllGameScoresAsync();
        players = await ApiService.GetAllPlayersAsync();
    }

    private string GetRankText(int rank) => rank switch
    {
        1 => "1er",
        2 => "2eme",
        3 => "3eme",
        4 => "4eme",
        5 => "5eme",
        _ => $"{rank}eme"
    };

    private string GetRankingCardClass(int rank) => rank switch
    {
        1 => "rank-first",
        2 => "rank-second",
        3 => "rank-third",
        _ => ""
    };

    private string GetRowClass(string gameName) => gameName switch
    {
        "Total" => "total-row",
        "Whistledown" => "whistledown-row",
        _ => ""
    };

    private string FormatScore(int score) => score == 0 ? "-" : $"{score}pts";

    private void ShowImageModal(string imageUrl)
    {
        selectedImage = imageUrl;
        showModal = true;
    }

    private void CloseImageModal()
    {
        showModal = false;
        selectedImage = "";
    }
}
