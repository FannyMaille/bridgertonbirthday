                    else
                    {
                        <div style="text-align: center; padding: 60px 20px; color: #999;">
                            <div style="font-size: 3rem; margin-bottom: 20px;">📭</div>
                            <p style="font-size: 1.2rem;">Aucun article publié pour le moment</p>
                        </div>
                    }
                </div>
            }
            else if (currentTab == "voting")
            {
                <div class="dashboard-content">
                    <h2>🗳️ Activation des Votes</h2>
                    
                    @if (families != null)
                    {
                        <div class="cards-grid">
                            @foreach (var family in families)
                            {
                                var voteResult = voteResults?.FirstOrDefault(vr => vr.FamilyId == family.Id);
                                var voteCount = voteResult?.Votes.Count ?? 0;
                                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                                
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">@family.Name</div>
                                        <span class="info-card-badge @(family.VotingEnabled ? "badge-success" : "badge-danger")">
                                            @(family.VotingEnabled ? "ACTIF" : "INACTIF")
                                        </span>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@family.VotingEnabled" @onchange="e => ToggleVoting(family.Id, (bool)(e.Value ?? false))" />
                                        <span>@(family.VotingEnabled ? "Vote autorisé" : "Vote désactivé")</span>
                                    </label>
                                    
                                    <div style="margin-top: 15px; padding: 12px; background: #f8f9fa; border-radius: 8px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                            <span style="font-weight: 600; color: #495057;">Lady Whistledown:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span style="color: #6c757d;">
                                                    @if (visibleWhistledowns.Contains(family.Id))
                                                    {
                                                        @(ladyWhistledown?.Name ?? "Non définie")
                                                    }
                                                    else
                                                    {
                                                        <span>••••••••</span>
                                                    }
                                                </span>
                                                @if (ladyWhistledown != null)
                                                {
                                                    <button class="toggle-visibility-btn" @onclick="() => ToggleWhistledownVisibility(family.Id)" title="@(visibleWhistledowns.Contains(family.Id) ? "Masquer" : "Afficher")">
                                                        @(visibleWhistledowns.Contains(family.Id) ? "👁️" : "👁️‍🗨️")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                            <span style="font-weight: 600, color: #495057;">Votes enregistrés:</span>
