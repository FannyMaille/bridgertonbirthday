@page "/admin"
@using BridgertonGame.Client.Shared
@using BridgertonGame.Shared.Models
@using BridgertonGame.Shared.DTOs
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject ApiService ApiService
@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Admin Dashboard - The Bridgerton Game</PageTitle>

<link href="css/admin.css" rel="stylesheet" />

@if (!isAdmin)
{
    <div class="admin-login-section">
        <div class="login-card">
            <div class="admin-avatar-wrapper">
                <img src="images/AdminAvatar.png" alt="Admin" class="admin-avatar" onerror="this.style.display='none'" />
            </div>

            <h1>Administration</h1>

            <div class="login-form">
                <div class="login-form-group">
                    <label>Identifiant</label>
                    <input type="text" @bind="username" placeholder="Entrez votre identifiant" />
                </div>
                <div class="login-form-group">
                    <label>Mot de passe</label>
                    <input type="password" @bind="password" @onkeypress="HandleKeyPress" placeholder="Entrez votre mot de passe" />
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error">@errorMessage</div>
                }
                <button class="login-submit-btn" @onclick="ValidateLogin">
                    Se connecter
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <div class="dashboard-sidebar">
            <div class="sidebar-header">
                <h1>🎩 Admin</h1>
                <p class="subtitle">The Bridgerton Game</p>
            </div>

            <div class="sidebar-menu">
                <button class="sidebar-menu-item @(currentTab == "scores" ? "active" : "")" @onclick='() => SetTab("scores")'>
                    <span class="sidebar-menu-icon">📊</span>
                    <span>Scores</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "users" ? "active" : "")" @onclick='() => SetTab("users")'>
                    <span class="sidebar-menu-icon">👤</span>
                    <span>Utilisateurs</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "articles" ? "active" : "")" @onclick='() => SetTab("articles")'>
                    <span class="sidebar-menu-icon">📰</span>
                    <span>Articles</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "voting" ? "active" : "")" @onclick='() => SetTab("voting")'>
                    <span class="sidebar-menu-icon">🗳️</span>
                    <span>Votes</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "reveal" ? "active" : "")" @onclick='() => SetTab("reveal")'>
                    <span class="sidebar-menu-icon">🎭</span>
                    <span>Révélations</span>
                </button>
            </div>

            <div class="sidebar-footer">
                <button class="modern-btn btn-outline btn-full-width" @onclick="Logout">
                    🚪 Déconnexion
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-main">
            <div class="dashboard-header">
                <h1>Dashboard Administrateur</h1>
                <p class="subtitle">Gérez l'événement Bridgerton en temps réel</p>
            </div>

            <!-- Statistics Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Utilisateurs</div>
                        <div class="stat-card-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                            👤
                        </div>
                    </div>
                    <div class="stat-card-value">@(players?.Count ?? 0)</div>
                    <div class="stat-card-label">Joueurs inscrits</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Familles</div>
                        <div class="stat-card-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                            👥
                        </div>
                    </div>
                    <div class="stat-card-value">@(families?.Count ?? 0)</div>
                    <div class="stat-card-label">Familles inscrites</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Articles</div>
                        <div class="stat-card-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                            📰
                        </div>
                    </div>
                    <div class="stat-card-value">@(articles?.Count ?? 0)</div>
                    <div class="stat-card-label">Publications Whistledown</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Lady Whistledown</div>
                        <div class="stat-card-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white;">
                            🎭
                        </div>
                    </div>
                    <div class="stat-card-value">@(players?.Count(p => p.IsLadyWhistledown) ?? 0)</div>
                    <div class="stat-card-label">Identités secrètes</div>
                </div>
            </div>

            <!-- Tab Content -->
            @if (currentTab == "scores")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">📊 Gestion des Scores</h2>
                        <button class="modern-btn btn-primary" @onclick="AddNewGame">
                            ➕ Ajouter un jeu
                        </button>
                    </div>
                    
                    @if (families != null && gameScores != null)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Jeu</th>
                                    @foreach (var family in families)
                                    {
                                        <th style="text-align: center;">@family.Name</th>
                                    }
                                    <th style="text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gameScore in gameScores.Where(g => g.GameName != "Total" && g.GameName != "Pénalités Whistledown"))
                                {
                                    <tr>
                                        <td style="font-weight: 600;">
                                            @if (editingGameId == gameScore.GameName)
                                            {
                                                <div style="display: flex; gap: 8px, align-items: center;">
                                                    <input type="text" class="score-input" style="width: 200px; text-align: left;" @bind="editingGameName" />
                                                    <button class="icon-btn btn-success" @onclick="() => SaveGameName(gameScore.GameName)" title="Enregistrer">
                                                        ✓
                                                    </button>
                                                    <button class="icon-btn btn-danger" @onclick="CancelEditGameName" title="Annuler">
                                                        ✕
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@gameScore.GameName</span>
                                            }
                                        </td>
                                        @foreach (var family in families)
                                        {
                                            var score = gameScore.FamilyScores.ContainsKey(family.Id) ? gameScore.FamilyScores[family.Id] : 0;
                                            <td style="text-align: center;">
                                                <input type="number" class="score-input" value="@score" @onchange="e => UpdateScore(gameScore.GameName, family.Id, e.Value?.ToString())" />
                                            </td>
                                        }
                                        <td style="text-align: center;">
                                            <div style="display: flex; gap: 8px; justify-content: center;">
                                                @if (editingGameId != gameScore.GameName)
                                                {
                                                    <button class="icon-btn btn-primary" @onclick="() => StartEditGameName(gameScore.GameName)" title="Modifier le nom">
                                                        ✏️
                                                    </button>
                                                }
                                                <button class="icon-btn btn-danger" @onclick="() => DeleteGame(gameScore.GameName)" title="Supprimer le jeu">
                                                    🗑️
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="section-header" style="margin-top: 40px;">
                            <h3 class="section-title">⚠️ Pénalités Whistledown</h3>
                        </div>
                        <div style="background: #fff3cd; border: 2px solid #ffc107; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                            <p style="margin: 0 0 10px 0; color: #856404; font-size: 0.95rem;">
                                <strong>ℹ️ Système automatique de points :</strong>
                            </p>
                            <ul style="margin: 0; padding-left: 20px; color: #856404; font-size: 0.95rem;">
                                <li style="margin-bottom: 5px;">
                                    <strong>Pénalité famille :</strong> Chaque article publié ajoute <strong>-10 points</strong> à la famille
                                </li>
                                <li>
                                    <strong>Récompense Lady Whistledown :</strong> Chaque article publié ajoute <strong>+10 points personnels</strong> à Lady Whistledown
                                </li>
                            </ul>
                            <p style="margin: 10px 0 0 0; color: #856404; font-size: 0.9rem; font-style: italic;">
                                Vous pouvez ajuster manuellement les pénalités ci-dessous si nécessaire. Les points personnels des joueurs se gèrent dans la page "Classement".
                            </p>
                        </div>
                        <div class="penalty-grid">
                            @foreach (var family in families)
                            {
                                var penalty = penalties.ContainsKey(family.Id) ? penalties[family.Id] : 0;
                                var articleCount = articles?.Count(a => a.FamilyId == family.Id) ?? 0;
                                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                                
                                <div class="penalty-input-group">
                                    <label>@family.Name</label>
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <input type="number" value="@penalty" @onchange="e => UpdatePenalty(family.Id, e.Value?.ToString())" />
                                        <small style="color: #c62828; font-weight: 600;">
                                            Famille: -@penalty pts
                                        </small>
                                        @if (ladyWhistledown != null)
                                        {
                                            <small style="color: #2e7d32; font-weight: 600;">
                                                @ladyWhistledown.Name: +@penalty pts
                                            </small>
                                        }
                                        <small style="color: #666; margin-top: 5px;">
                                            @articleCount article(s) publié(s)
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "users")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">👤 Gestion des Utilisateurs</h2>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" 
                                   placeholder="🔍 Rechercher par nom, famille..." 
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   style="padding: 10px 15px; border: 2px solid #e8ebef; border-radius: 8px; min-width: 250px;" />
                            <button class="modern-btn btn-primary" @onclick="AddNewPlayer">
                                ➕ Ajouter un personnage
                            </button>
                        </div>
                    </div>
                    
                    @if (players != null && families != null)
                    {
                        var filteredPlayers = string.IsNullOrWhiteSpace(searchQuery) 
                            ? players 
                            : players.Where(p => 
                                p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                families.FirstOrDefault(f => f.Id == p.FamilyId)?.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true
                            ).ToList();

                        <div class="users-grid">
                            @foreach (var player in filteredPlayers.OrderBy(p => p.FamilyId).ThenBy(p => p.Name))
                            {
                                var playerFamily = families.FirstOrDefault(f => f.Id == player.FamilyId);
                                
                                <div class="user-card">
                                    <div class="user-card-header">
                                        <div class="user-avatar-wrapper">
                                            <img src="@player.ImageUrl" alt="@player.Name" class="user-avatar" />
                                            @if (player.IsLadyWhistledown)
                                            {
                                                <div class="whistledown-badge">🎭</div>
                                            }
                                        </div>
                                        <div class="user-info">
                                            <div class="user-name">@player.Name</div>
                                            <div class="user-title">@player.Title</div>
                                            <div class="user-family">
                                                👥 Famille @(playerFamily?.Name ?? "Inconnue")
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-body">
                                        <div class="user-detail-row">
                                            <span class="user-detail-label">Code d'accès:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="user-detail-value">
                                                    @if (visibleCodes.Contains(player.Id))
                                                    {
                                                        @player.Code
                                                    }
                                                    else
                                                    {
                                                        <span>••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleCodeVisibility(player.Id)" title="@(visibleCodes.Contains(player.Id) ? "Masquer" : "Afficher")">
                                                    @(visibleCodes.Contains(player.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                            </div>
                                        </div>
                                        <div class="user-detail-row" style="border-bottom: none;">
                                            <span class="user-detail-label">Rôle:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="user-detail-value">
                                                    @if (visibleRoles.Contains(player.Id))
                                                    {
                                                        @player.Role
                                                    }
                                                    else
                                                    {
                                                        <span>•••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleRoleVisibility(player.Id)" title="@(visibleRoles.Contains(player.Id) ? "Masquer" : "Afficher")">
                                                    @(visibleRoles.Contains(player.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-footer">
                                        <button class="icon-btn btn-primary" @onclick="() => EditUser(player)" title="Modifier">
                                            ✏️
                                        </button>
                                        <button class="icon-btn @(player.IsLadyWhistledown ? "btn-warning" : "btn-success")" 
                                                @onclick="() => ToggleLadyWhistledown(player)" 
                                                title="@(player.IsLadyWhistledown ? "Retirer Lady Whistledown" : "Définir comme Lady Whistledown")">
                                            🎭
                                        </button>
                                        <button class="icon-btn btn-danger" @onclick="() => DeletePlayer(player)" title="Supprimer">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!filteredPlayers.Any())
                        {
                            <div style="text-align: center; padding: 60px 20px; color: #999;">
                                <div style="font-size: 3rem; margin-bottom: 20px;">🔍</div>
                                <p style="font-size: 1.2rem;">Aucun utilisateur trouvé</p>
                            </div>
                        }
                    }
                </div>
            }
            else if (currentTab == "articles")
            {
                <div class="dashboard-content">
                    <h2>📰 Gestion des Articles Whistledown</h2>
                    
                    @if (articles != null && articles.Any())
                    {
                        @foreach (var article in articles)
                        {
                            <div class="article-card">
                                <div class="article-header">
                                    <div class="article-meta">
                                        <div class="article-family">@article.FamilyName</div>
                                        <div class="article-date">📅 @article.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</div>
                                    </div>
                                    <button class="modern-btn btn-danger" @onclick="() => DeleteArticle(article.Id)">
                                        🗑️ Supprimer
                                    </button>
                                </div>
                                <div class="article-content">
                                    @article.Content
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 60px 20px; color: #999;">
                            <div style="font-size: 3rem; margin-bottom: 20px;">📭</div>
                            <p style="font-size: 1.2rem;">Aucun article publié pour le moment</p>
                        </div>
                    }
                </div>
            }
            else if (currentTab == "voting")
            {
                <div class="dashboard-content">
                    <h2>🗳️ Activation des Votes</h2>
                    
                    @if (families != null)
                    {
                        <div class="cards-grid">
                            @foreach (var family in families)
                            {
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">@family.Name</div>
                                        <span class="info-card-badge @(family.VotingEnabled ? "badge-success" : "badge-danger")">
                                            @(family.VotingEnabled ? "ACTIF" : "INACTIF")
                                        </span>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@family.VotingEnabled" @onchange="e => ToggleVoting(family.Id, (bool)(e.Value ?? false))" />
                                        <span>@(family.VotingEnabled ? "Vote autorisé" : "Vote désactivé")</span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "reveal")
            {
                <div class="dashboard-content">
                    <h2>🎭 Révélation Lady Whistledown</h2>
                    
                    @if (families != null)
                    {
                        <div class="cards-grid">
                            @foreach (var family in families)
                            {
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">@family.Name</div>
                                        @if (family.Revealed)
                                        {
                                            <span class="info-card-badge badge-success">
                                                <span class="status-indicator status-active"></span>
                                                RÉVÉLÉ
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="modern-btn btn-primary" @onclick="() => RevealWhistledown(family.Id)">
                                                🎭 Révéler
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div style="text-align: center; margin-top: 40px; padding-top: 30px; border-top: 2px solid #e8ebef;">
                            <button class="modern-btn btn-success" style="padding: 16px 40px; font-size: 1.1rem;" @onclick="RevealAll">
                                🎉 Révéler Toutes les Familles
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (showEditModal && editingPlayer != null)
{
    <div class="modal-overlay" @onclick="CloseEditModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isCreatingPlayer ? "➕ Créer un personnage" : "✏️ Modifier l'utilisateur")</h3>
                <button class="modal-close-btn" @onclick="CloseEditModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" @bind="editingPlayer.Name" class="form-control" placeholder="Ex: Daphné Bridgerton" />
                </div>
                <div class="form-group">
                    <label>Titre</label>
                    <input type="text" @bind="editingPlayer.Title" class="form-control" placeholder="Ex: Duchesse d'Hastings" />
                </div>
                <div class="form-group">
                    <label>Code d'accès</label>
                    <input type="text" @bind="editingPlayer.Code" class="form-control" style="text-transform: uppercase;" placeholder="Ex: DAPHNE" />
                </div>
                <div class="form-group">
                    <label>Rôle</label>
                    <select @bind="editingPlayer.Role" @bind:after="OnRoleChanged" class="form-control">
                        <option value="">-- Sélectionner un rôle --</option>
                        <option value="Maîtresse de maison">Maîtresse de maison</option>
                        <option value="Lady Whistledown">Lady Whistledown</option>
                        <option value="Invité(e)">Invité(e)</option>
                    </select>
                    @if (editingPlayer.Role == "Lady Whistledown")
                    {
                        <small style="color: #28a745; margin-top: 5px; display: block;">
                            ✓ Ce joueur sera marqué comme Lady Whistledown
                        </small>
                    }
                </div>
                <div class="form-group">
                    <label>URL de l'image</label>
                    <input type="text" @bind="editingPlayer.ImageUrl" class="form-control" placeholder="Ex: images/daphne.jpg" />
                    @if (!string.IsNullOrEmpty(editingPlayer.ImageUrl))
                    {
                        <div style="margin-top: 10px; text-align: center;">
                            <img src="@editingPlayer.ImageUrl" alt="Preview" style="max-width: 150px; max-height: 150px; border-radius: 8px; border: 2px solid #e8ebef;" onerror="this.style.display='none'" />
                        </div>
                    }
                </div>
                <div class="form-group">
                    <label>Famille</label>
                    <select @bind="editingPlayer.FamilyId" class="form-control">
                        <option value="">-- Sélectionner une famille --</option>
                        @foreach (var family in families ?? new List<Family>())
                        {
                            <option value="@family.Id">@family.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modern-btn btn-outline" @onclick="CloseEditModal">Annuler</button>
                <button class="modern-btn btn-primary" @onclick="SaveUser" disabled="@(!IsPlayerValid())">
                    @(isCreatingPlayer ? "➕ Créer" : "💾 Enregistrer")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isAdmin = false;
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private string currentTab = "scores";
    private string searchQuery = "";

    private List<Family>? families;
    private List<GameScore>? gameScores;
    private List<Article>? articles;
    private List<Player>? players;
    private Dictionary<string, int> penalties = new();

    private string? editingGameId = null;
    private string editingGameName = "";
    private Player? editingPlayer = null;
    private bool showEditModal = false;
    private bool isCreatingPlayer = false;

    private HashSet<string> visibleCodes = new();
    private HashSet<string> visibleRoles = new();

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await AuthService.IsAdminAuthenticatedAsync();
        if (isAdmin)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        families = await ApiService.GetAllFamiliesAsync();
        gameScores = await ApiService.GetAllGameScoresAsync();
        articles = await ApiService.GetAllArticlesAsync();
        players = await ApiService.GetAllPlayersAsync();
        penalties = await ApiService.GetPenaltiesAsync();
    }

    private async Task ValidateLogin()
    {
        var request = new AdminLoginRequest { Username = username, Password = password };
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/admin", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AdminLoginResponse>();
                if (result?.Success == true)
                {
                    isAdmin = true;
                    await AuthService.SetAdminAuthenticatedAsync(true);
                    await LoadData();
                    errorMessage = "";
                }
                else
                {
                    errorMessage = result?.ErrorMessage ?? "Erreur de connexion";
                }
            }
            else
            {
                errorMessage = "Login ou mot de passe incorrect";
            }
        }
        catch
        {
            errorMessage = "Erreur de connexion";
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ValidateLogin();
        }
    }

    private void SetTab(string tab)
    {
        currentTab = tab;
    }

    private async Task UpdateScore(string gameName, string familyId, string? value)
    {
        if (int.TryParse(value, out int points) && gameScores != null)
        {
            var game = gameScores.FirstOrDefault(g => g.GameName == gameName);
            if (game != null)
            {
                game.FamilyScores[familyId] = points;
                await Http.PutAsJsonAsync("api/gamescores", game);
            }
        }
    }

    private async Task UpdatePenalty(string familyId, string? value)
    {
        if (int.TryParse(value, out int penalty))
        {
            penalties[familyId] = penalty;
            await Http.PutAsJsonAsync($"api/gamescores/penalties/{familyId}", penalty);
        }
    }

    private void StartEditGameName(string gameName)
    {
        editingGameId = gameName;
        editingGameName = gameName;
    }

    private void CancelEditGameName()
    {
        editingGameId = null;
        editingGameName = "";
    }

    private async Task SaveGameName(string oldGameName)
    {
        if (string.IsNullOrWhiteSpace(editingGameName) || gameScores == null)
        {
            CancelEditGameName();
            return;
        }

        var game = gameScores.FirstOrDefault(g => g.GameName == oldGameName);
        if (game != null && oldGameName != editingGameName)
        {
            // Delete old game
            await Http.DeleteAsync($"api/gamescores/{Uri.EscapeDataString(oldGameName)}");
            
            // Create new game with new name
            game.GameName = editingGameName;
            await Http.PostAsJsonAsync("api/gamescores", game);
            
            await LoadData();
        }
        
        CancelEditGameName();
    }

    private async Task AddNewGame()
    {
        if (families == null || gameScores == null) return;

        var newGameName = $"Nouveau Jeu {gameScores.Count(g => g.GameName != "Total" && g.GameName != "Pénalités Whistledown") + 1}";

        var newGame = new GameScore
        {
            GameName = newGameName,
            FamilyScores = new Dictionary<string, int>()
        };

        foreach (var family in families)
        {
            newGame.FamilyScores[family.Id] = 0;
        }

        await Http.PostAsJsonAsync("api/gamescores", newGame);
        await LoadData();
    }

    private async Task DeleteGame(string gameName)
    {
        if (gameScores == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le jeu '{gameName}' ?\n\nCette action est irréversible.");
        
        if (confirmed)
        {
            await Http.DeleteAsync($"api/gamescores/{Uri.EscapeDataString(gameName)}");
            await LoadData();
        }
    }

