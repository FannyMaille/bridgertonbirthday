                                                @voteCount
                                            </span>
                                        </div>
                                        
                                        @if (voteResult != null && voteResult.Votes.Any())
                                        {
                                            <details style="margin-top: 10px;">
                                                <summary style="cursor: pointer; font-weight: 600; color: #495057; padding: 8px; background: white; border-radius: 5px; margin-bottom: 5px;">
                                                    📊 Voir les détails des votes
                                                </summary>
                                                <div style="margin-top: 8px; max-height: 200px; overflow-y: auto;">
                                                    @foreach (var vote in voteResult.Votes)
                                                    {
                                                        <div style="padding: 8px; margin: 5px 0; background: white; border-left: 3px solid @(vote.IsCorrect ? "#28a745" : "#dc3545"); border-radius: 3px; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                                                            <div>
                                                                <strong>@vote.VoterName</strong>
                                                                <span style="color: #6c757d;"> → </span>
                                                                <strong>@vote.VotedForName</strong>
                                                            </div>
                                                            <div style="display: flex; gap: 8px; align-items: center;">
                                                                <span style="font-weight: bold; color: @(vote.IsCorrect ? "#28a745" : "#dc3545");">
                                                                    @(vote.IsCorrect ? "✓" : "✗")
                                                                </span>
                                                                <button class="icon-btn btn-danger" 
                                                                        @onclick="() => DeleteVote(family.Id, vote.VoterId, vote.VoterName)" 
                                                                        title="Supprimer ce vote"
                                                                        style="padding: 4px 8px; font-size: 0.75rem;">
                                                                    🗑️
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                            
                                            @if (family.Revealed)
                                            {
                                                <div style="margin-top: 10px; padding: 8px; background: @(voteResult.TotalPointsAwarded >= 0 ? "#d4edda" : "#f8d7da"); border-radius: 5px; text-align: center;">
                                                    <div style="font-size: 0.8rem; color: @(voteResult.TotalPointsAwarded >= 0 ? "#155724" : "#721c24"); margin-bottom: 2px;">
                                                        Résultat
                                                    </div>
                                                    <div style="font-size: 1.2rem; font-weight: bold; color: @(voteResult.TotalPointsAwarded >= 0 ? "#155724" : "#721c24");">
                                                        ✅ @voteResult.TotalCorrectVotes  |  ❌ @voteResult.TotalIncorrectVotes
                                                    </div>
                                                    <div style="font-size: 0.9rem; font-weight: bold, color: @(voteResult.TotalPointsAwarded >= 0 ? "#155724" : "#721c24"); margin-top: 4px;">
                                                        @(voteResult.TotalPointsAwarded > 0 ? "+" : "")@voteResult.TotalPointsAwarded pts
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="margin-top: 10px; padding: 8px; background: #fff3cd; border-radius: 5px; text-align: center; color: #856404; font-size: 0.85rem;">
                                                    ⏳ En attente de révélation
                                                </div>
                                            }
                                        }
                                        else if (family.VotingEnabled)
                                        {
                                            <div style="margin-top: 10px; padding: 8px; background: #e7f3ff; border-radius: 5px; text-align: center; color: #004085; font-size: 0.85rem;">
                                                👥 Aucun vote pour le moment
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "reveal")
            {
                <div class="dashboard-content">
                    <h2>🎭 Révélation Lady Whistledown</h2>
                    
                    @if (families != null)
                    {
                        <div class="cards-grid">
                            @foreach (var family in families)
                            {
                                var voteResult = voteResults?.FirstOrDefault(vr => vr.FamilyId == family.Id);
                                
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">@family.Name</div>
                                        <span class="info-card-badge @(family.Revealed ? "badge-success" : "badge-danger")">
                                            @(family.Revealed ? "RÉVÉLÉ" : "NON RÉVÉLÉ")
                                        </span>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@family.Revealed" @onchange="e => ToggleReveal(family.Id, (bool)(e.Value ?? false))" />
                                        <span>@(family.Revealed ? "Révélé" : "Non révélé")</span>
                                    </label>
                                    
                                    @if (family.Revealed && voteResult != null)
                                    {
                                        <div style="margin-top: 15px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
                                            <div style="font-weight: 600; margin-bottom: 10px; color: #2c3e50; display: flex; align-items: center; gap: 8px;">
                                                <span>🎭</span>
                                                <span>
                                                    @if (visibleWhistledowns.Contains(family.Id))
                                                    {
                                                        @voteResult.ActualLadyWhistledownName
                                                    }
                                                    else
                                                    {
                                                        <span>••••••••</span>
                                                    }
                                                </span>
                                                @if (voteResult.ActualLadyWhistledownName != null)
                                                {
                                                    <button class="toggle-visibility-btn" @onclick="() => ToggleWhistledownVisibility(family.Id)" title="@(visibleWhistledowns.Contains(family.Id) ? "Masquer" : "Afficher")">
                                                        @(visibleWhistledowns.Contains(family.Id) ? "👁️" : "👁️‍🗨️")
                                                    </button>
                                                }
                                            </div>
                                            
                                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                                                <div style="text-align: center; padding: 8px; background: #d4edda; border-radius: 5px;">
                                                    <div style="font-size: 1.5rem; font-weight: bold, color: #28a745;">@voteResult.TotalCorrectVotes</div>
                                                    <div style="font-size: 0.85rem; color: #155724;">Votes corrects</div>
                                                </div>
                                                <div style="text-align: center; padding: 8px; background: #f8d7da; border-radius: 5px;">
                                                    <div style="font-size: 1.5rem; font-weight: bold, color: #dc3545;">@voteResult.TotalIncorrectVotes</div>
                                                    <div style="font-size: 0.85rem; color: #721c24;">Votes incorrects</div>
                                                </div>
                                            </div>
                                            
                                            <div style="text-align: center; padding: 10px; background: @(voteResult.TotalPointsAwarded >= 0 ? "#d4edda" : "#f8d7da"); border-radius: 5px; font-weight: bold; color: @(voteResult.TotalPointsAwarded >= 0 ? "#155724" : "#721c24");">
                                                Points attribués: @(voteResult.TotalPointsAwarded > 0 ? "+" : "")@voteResult.TotalPointsAwarded
                                            </div>
                                            
                                            @if (voteResult.Votes.Any())
                                            {
                                                <details style="margin-top: 10px;">
                                                    <summary style="cursor: pointer; font-weight: 600; color: #495057; padding: 5px;">
                                                        📊 Détails des votes (@voteResult.Votes.Count)
                                                    </summary>
                                                    <div style="margin-top: 10px;">
                                                        @foreach (var vote in voteResult.Votes)
                                                        {
                                                            <div style="padding: 8px; margin: 5px 0; background: white; border-left: 3px solid @(vote.IsCorrect ? "#28a745" : "#dc3545"); border-radius: 3px; font-size: 0.9rem;">
                                                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                                                    <div>
                                                                        <strong>@vote.VoterName</strong> a voté pour <strong>@vote.VotedForName</strong>
                                                                    </div>
                                                                    <div style="display: flex, gap: 8px; align-items: center;">
                                                                        <span style="font-weight: bold; color: @(vote.IsCorrect ? "#28a745" : "#dc3545");">
                                                                            @(vote.IsCorrect ? "✓" : "✗") @(vote.PointsAwarded > 0 ? "+" : "")@vote.PointsAwarded pts
                                                                        </span>
                                                                        <button class="icon-btn btn-danger" 
                                                                                @onclick="() => DeleteVote(family.Id, vote.VoterId, vote.VoterName)" 
                                                                                title="Supprimer ce vote"
                                                                                style="padding: 4px 8px; font-size: 0.75rem;">
                                                                            🗑️
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div style="text-align: center; margin-top: 40px; padding-top: 30px; border-top: 2px solid #e8ebef;">
                            <button class="modern-btn btn-success" style="padding: 16px 40px; font-size: 1.1rem;" @onclick="RevealAll">
                                🎉 Révéler Toutes les Familles
                            </button>
                        </div>
                    }
                </div>
            }
            else if (currentTab == "quiz")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">📝 Gestion du Quiz</h2>
                    </div>

                    <div class="modern-card" style="margin-bottom: 30px;">
                        <div class="card-header">
                            <div class="header-icon">⚙️</div>
                            <h3>Contrôle du Quiz</h3>
                        </div>
                        <div class="card-body">
                            <div class="quiz-control-grid">
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">État du Quiz</div>
                                        <span class="info-card-badge @(quizState?.IsEnabled == true ? "badge-success" : "badge-danger")">
                                            @(quizState?.IsEnabled == true ? "ACTIF" : "INACTIF")
                                        </span>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@(quizState?.IsEnabled ?? false)" @onchange="e => ToggleQuizEnabled((bool)(e.Value ?? false))" />
                                        <span>@(quizState?.IsEnabled == true ? "Quiz activé" : "Quiz désactivé")</span>
                                    </label>
                                </div>
                                
                                <div class="info-card">
                                    <div class="info-card-header">
                                        <div class="info-card-title">Question Affichée</div>
                                    </div>
                                    <select class="modern-select" @bind="currentQuestionNumber" @bind:after="UpdateCurrentQuestion">
                                        <option value="0">Aucune question</option>
                                        @foreach (var q in quizQuestions ?? new List<Quiz>())
                                        {
                                            <option value="@q.QuestionNumber">Question @q.QuestionNumber</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (familyQuizSummary != null && familyQuizSummary.Any(f => f.TotalAnswers > 0))
                    {
                        <div class="modern-card" style="margin-bottom: 30px;">
                            <div class="card-header">
                                <div class="header-icon">🏆</div>
                                <h3>Résultats par Famille</h3>
                            </div>
                            <div class="card-body">
                                <div style="margin-bottom: 20px; padding: 15px; background: #fff3cd; border: 2px solid #ffc107; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                                    <div style="flex: 1; min-width: 250px;">
                                        <p style="margin: 0; color: #856404; font-weight: 600;">
                                            ⚠️ Attention : Cette action supprimera TOUTES les réponses de TOUS les joueurs
                                        </p>
                                        <p style="margin: 5px 0 0 0; color: #856404; font-size: 0.9rem;">
                                            Total actuel : @(quizStatistics?.Sum(s => s.TotalAnswers) ?? 0) réponse(s) enregistrée(s)
                                        </p>
                                    </div>
                                    <button class="modern-btn btn-danger" @onclick="ResetAllQuizAnswers" style="white-space: nowrap;">
                                        🗑️ Réinitialiser tout le quiz
                                    </button>
                                </div>

                                <div class="quiz-summary-grid">
                                    @foreach (var summary in familyQuizSummary.OrderByDescending(s => s.SuccessRate))
                                    {
                                        var rankColor = summary.SuccessRate >= 80 ? "#28a745" : 
                                                       summary.SuccessRate >= 60 ? "#ffc107" : 
                                                       summary.SuccessRate >= 40 ? "#fd7e14" : "#dc3545";
                                        
                                        <div style="padding: 15px; background: linear-gradient(135deg, #f8f9fa 0%, white 100%); border-radius: 10px; border: 2px solid #e8ebef; text-align: center;">
                                            <div style="font-weight: 700; color: #7172C5; font-size: 1.1rem; margin-bottom: 10px;">
                                                @summary.FamilyName
                                            </div>
                                            <div style="font-size: 2.5rem; font-weight: bold; color: @rankColor; margin-bottom: 5px;">
                                                @summary.CorrectAnswers/@summary.TotalAnswers
                                            </div>
                                            <div style="font-size: 0.9rem; color: #666; margin-bottom: 10px;">
                                                @summary.SuccessRate.ToString("F0")% de réussite
                                            </div>
                                            <div style="width: 100%; height: 8px; background: #e9ecef; border-radius: 4px; overflow: hidden;">
                                                <div style="width: @summary.SuccessRate%; height: 100%; background: @rankColor; transition: width 0.3s ease;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="section-header">
                        <h3 style="margin: 0;">Questions</h3>
                        <button class="modern-btn btn-primary" @onclick="AddNewQuestion">
                            ➕ Ajouter une question
                        </button>
                    </div>

                    @if (quizQuestions != null && quizQuestions.Any())
                    {
                        <div class="cards-grid">
                            @foreach (var question in quizQuestions.OrderBy(q => q.QuestionNumber))
                            {
                                var stat = quizStatistics?.FirstOrDefault(s => s.QuestionNumber == question.QuestionNumber);
                                var hasAnswers = stat != null && stat.TotalAnswers > 0;
                                
                                <div class="info-card" style="position: relative;">
                                    <div class="info-card-header">
                                        <div class="info-card-title">Question @question.QuestionNumber</div>
                                        <div style="display: flex; gap: 8px; align-items: center;">
                                            @if (hasAnswers)
                                            {
                                                <span class="info-card-badge badge-info">@stat.TotalAnswers réponse(s)</span>
                                            }
                                            <button class="icon-btn btn-primary" @onclick="() => EditQuestion(question)" title="Modifier">
                                                ✏️
                                            </button>
                                            <button class="icon-btn btn-danger" @onclick="() => DeleteQuestion(question.Id)" title="Supprimer">
                                                🗑️
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div style="padding: 15px;">
                                        <p style="font-weight: 600; margin-bottom: 15px; color: #2c3e50;">@question.Question</p>
                                        <div style="display: grid; gap: 8px;">
                                            <div style="padding: 8px; background: @(question.CorrectAnswer == "A" ? "#d4edda" : "#f8f9fa"); border-radius: 5px; border-left: 3px solid @(question.CorrectAnswer == "A" ? "#28a745" : "#dee2e6");">
                                                <strong>A.</strong> @question.OptionA
                                            </div>
                                            <div style="padding: 8px; background: @(question.CorrectAnswer == "B" ? "#d4edda" : "#f8f9fa"); border-radius: 5px; border-left: 3px solid @(question.CorrectAnswer == "B" ? "#28a745" : "#dee2e6");">
                                                <strong>B.</strong> @question.OptionB
                                            </div>
                                            <div style="padding: 8px; background: @(question.CorrectAnswer == "C" ? "#d4edda" : "#f8f9fa"); border-radius: 5px; border-left: 3px solid @(question.CorrectAnswer == "C" ? "#28a745" : "#dee2e6");">
                                                <strong>C.</strong> @question.OptionC
                                            </div>
                                            <div style="padding: 8px; background: @(question.CorrectAnswer == "D" ? "#d4edda" : "#f8f9fa"); border-radius: 5px; border-left: 3px solid @(question.CorrectAnswer == "D" ? "#28a745" : "#dee2e6");">
                                                <strong>D.</strong> @question.OptionD
                                            </div>
                                        </div>
                                        <div style="margin-top: 10px; padding: 10px; background: #e7f3ff; border-radius: 5px; text-align: center;">
                                            <strong>Bonne réponse:</strong> <span style="color: #28a745; font-weight: bold;">@question.CorrectAnswer</span>
                                        </div>
                                        
                                        @if (hasAnswers)
                                        {
                                            <div style="margin-top: 15px; padding: 15px; background: #f8f9fa; border-radius: 8px; border: 2px solid #e8ebef;">
                                                <div style="font-weight: 600; color: #7172C5; margin-bottom: 10px; text-align: center;">
                                                    📊 Statistiques (@stat.TotalAnswers réponse(s))
                                                </div>
                                                
                                                <div style="display: grid; gap: 8px; margin-bottom: 15px;">
                                                    @foreach (var option in new[] { "A", "B", "C", "D" })
                                                    {
                                                        var count = stat.AnswerCounts.ContainsKey(option) ? stat.AnswerCounts[option] : 0;
                                                        var percentage = stat.TotalAnswers > 0 ? (count * 100.0 / stat.TotalAnswers) : 0;
                                                        var isCorrect = option == stat.CorrectAnswer;
                                                        
                                                        <div style="padding: 8px; background: white; border-radius: 5px; border-left: 3px solid @(isCorrect ? "#28a745" : "#6c757d");">
