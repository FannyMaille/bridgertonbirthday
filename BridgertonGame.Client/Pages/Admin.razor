@page "/admin"
@using BridgertonGame.Client.Shared
@using BridgertonGame.Shared.Models
@using BridgertonGame.Shared.DTOs
@using System.Net.Http.Json
@using Microsoft.JSInterop

<PageTitle>Admin Dashboard - The Bridgerton Game</PageTitle>

<link href="css/admin.css" rel="stylesheet" />
<link href="css/admin-users-families.css" rel="stylesheet" />

@if (!isAdmin)
{
    <div class="admin-login-section">
        <div class="login-card">
            <div class="admin-avatar-wrapper">
                <img src="images/AdminAvatar.png" alt="Admin" class="admin-avatar" onerror="this.style.display='none'" />
            </div>

            <h1>Administration</h1>

            <div class="login-form">
                <div class="login-form-group">
                    <label>Identifiant</label>
                    <input type="text" @bind="username" placeholder="Entrez votre identifiant" />
                </div>
                <div class="login-form-group">
                    <label>Mot de passe</label>
                    <input type="password" @bind="password" @onkeypress="HandleKeyPress" placeholder="Entrez votre mot de passe" />
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error">@errorMessage</div>
                }
                <button class="login-submit-btn" @onclick="ValidateLogin">
                    Se connecter
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="dashboard-layout">
        <!-- Mobile Menu Toggle Button -->
        <button class="mobile-menu-toggle @(isMobileMenuOpen ? "open" : "")" @onclick="ToggleMobileMenu">
            <div class="burger-icon">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </button>

        <!-- Sidebar Overlay for Mobile -->
        @if (isMobileMenuOpen)
        {
            <div class="sidebar-overlay show" @onclick="CloseMobileMenu"></div>
        }

        <!-- Sidebar -->
        <div class="dashboard-sidebar @(isMobileMenuOpen ? "open" : "")">
            <div class="sidebar-header">
                <h1>🎩 Admin</h1>
                <p class="subtitle">The Bridgerton Game</p>
            </div>

            <div class="sidebar-menu">
                <button class="sidebar-menu-item @(currentTab == "scores" ? "active" : "")" @onclick='() => SetTab("scores")'>
                    <span class="sidebar-menu-icon">📊</span>
                    <span>Scores</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "users" ? "active" : "")" @onclick='() => SetTab("users")'>
                    <span class="sidebar-menu-icon">👤</span>
                    <span>Utilisateurs</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "families" ? "active" : "")" @onclick='() => SetTab("families")'>
                    <span class="sidebar-menu-icon">👥</span>
                    <span>Familles</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "articles" ? "active" : "")" @onclick='() => SetTab("articles")'>
                    <span class="sidebar-menu-icon">📰</span>
                    <span>Articles</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "voting" ? "active" : "")" @onclick='() => SetTab("voting")'>
                    <span class="sidebar-menu-icon">🗳️</span>
                    <span>Votes</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "reveal" ? "active" : "")" @onclick='() => SetTab("reveal")'>
                    <span class="sidebar-menu-icon">🎭</span>
                    <span>Révélations</span>
                </button>
                <button class="sidebar-menu-item @(currentTab == "quiz" ? "active" : "")" @onclick='() => SetTab("quiz")'>
                    <span class="sidebar-menu-icon">📝</span>
                    <span>Quiz</span>
                </button>
            </div>

            <div class="sidebar-footer">
                <button class="modern-btn btn-outline btn-full-width" @onclick="Logout">
                    🚪 Déconnexion
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-main">
            <div class="dashboard-header">
                <h1>Dashboard Administrateur</h1>
                <p class="subtitle">Gérez l'événement Bridgerton en temps réel</p>
            </div>

            <!-- Statistics Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Utilisateurs</div>
                        <div class="stat-card-icon icon-users">
                            👤
                        </div>
                    </div>
                    <div class="stat-card-value">@(players?.Count ?? 0)</div>
                    <div class="stat-card-label">Joueurs inscrits</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Familles</div>
                        <div class="stat-card-icon icon-families">
                            👥
                        </div>
                    </div>
                    <div class="stat-card-value">@(families?.Count ?? 0)</div>
                    <div class="stat-card-label">Familles inscrites</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Articles</div>
                        <div class="stat-card-icon icon-articles">
                            📰
                        </div>
                    </div>
                    <div class="stat-card-value">@(articles?.Count ?? 0)</div>
                    <div class="stat-card-label">Publications Whistledown</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <div class="stat-card-title">Lady Whistledown</div>
                        <div class="stat-card-icon icon-whistledown">
                            🎭
                        </div>
                    </div>
                    <div class="stat-card-value">@(players?.Count(p => p.IsLadyWhistledown) ?? 0)</div>
                    <div class="stat-card-label">Identités secrètes</div>
                </div>
            </div>

            <!-- Tab Content -->
            @if (currentTab == "scores")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">📊 Gestion des Scores</h2>
                        <button class="modern-btn btn-primary" @onclick="AddNewGame">
                            ➕ Ajouter un jeu
                        </button>
                    </div>
                    
                    @if (families != null && gameScores != null)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Jeu</th>
                                    @foreach (var family in families)
                                    {
                                        <th style="text-align: center;">@family.Name</th>
                                    }
                                    <th style="text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gameScore in gameScores.Where(g => g.GameName != "Total" && g.GameName != "Pénalités Whistledown"))
                                {
                                    <tr>
                                        <td style="font-weight: 600;">
                                            @if (editingGameId == gameScore.GameName)
                                            {
                                                <div style="display: flex; gap: 8px, align-items: center;">
                                                    <input type="text" class="score-input" style="width: 200px; text-align: left;" @bind="editingGameName" />
                                                    <button class="icon-btn btn-success" @onclick="() => SaveGameName(gameScore.GameName)" title="Enregistrer">
                                                        ✓
                                                    </button>
                                                    <button class="icon-btn btn-danger" @onclick="CancelEditGameName" title="Annuler">
                                                        ✕
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@gameScore.GameName</span>
                                            }
                                        </td>
                                        @foreach (var family in families)
                                        {
                                            var score = gameScore.FamilyScores.ContainsKey(family.Id) ? gameScore.FamilyScores[family.Id] : 0;
                                            <td style="text-align: center;">
                                                <input type="number" class="score-input" value="@score" @onchange="e => UpdateScore(gameScore.GameName, family.Id, e.Value?.ToString())" />
                                            </td>
                                        }
                                        <td style="text-align: center;">
                                            <div style="display: flex; gap: 8px; justify-content: center;">
                                                @if (editingGameId != gameScore.GameName)
                                                {
                                                    <button class="icon-btn btn-primary" @onclick="() => StartEditGameName(gameScore.GameName)" title="Modifier le nom">
                                                        ✏️
                                                    </button>
                                                }
                                                <button class="icon-btn btn-danger" @onclick="() => DeleteGame(gameScore.GameName)" title="Supprimer le jeu">
                                                    🗑️
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="section-header" style="margin-top: 40px;">
                            <h3 class="section-title">⚠️ Pénalités Whistledown</h3>
                        </div>
                        <div style="background: #fff3cd; border: 2px solid #ffc107; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                            <p style="margin: 0 0 10px 0; color: #856404; font-size: 0.95rem;">
                                <strong>ℹ️ Système automatique de points :</strong>
                            </p>
                            <ul style="margin: 0; padding-left: 20px; color: #856404; font-size: 0.95rem;">
                                <li style="margin-bottom: 5px;">
                                    <strong>Pénalité famille :</strong> Chaque article publié ajoute <strong>-10 points</strong> à la famille
                                </li>
                                <li>
                                    <strong>Récompense Lady Whistledown :</strong> Chaque article publié ajoute <strong>+10 points personnels</strong> à Lady Whistledown
                                </li>
                            </ul>
                            <p style="margin: 10px 0 0 0; color: #856404; font-size: 0.9rem; font-style: italic;">
                                Vous pouvez ajuster manuellement les pénalités ci-dessous si nécessaire. Les points personnels des joueurs se gèrent dans la page "Classement".
                            </p>
                        </div>
                        <div class="penalty-grid">
                            @foreach (var family in families)
                            {
                                var penalty = penalties.ContainsKey(family.Id) ? penalties[family.Id] : 0;
                                var articleCount = articles?.Count(a => a.FamilyId == family.Id) ?? 0;
                                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                                
                                <div class="penalty-input-group">
                                    <label>@family.Name</label>
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <input type="number" value="@penalty" @onchange="e => UpdatePenalty(family.Id, e.Value?.ToString())" />
                                        <small style="color: #c62828; font-weight: 600;">
                                            Famille: -@penalty pts
                                        </small>
                                        @if (ladyWhistledown != null)
                                        {
                                            <small style="color: #2e7d32; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                                <span>
                                                    @if (visibleWhistledowns.Contains(family.Id))
                                                    {
                                                        @ladyWhistledown.Name
                                                    }
                                                    else
                                                    {
                                                        <span>••••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleWhistledownVisibility(family.Id)" title="@(visibleWhistledowns.Contains(family.Id) ? "Masquer" : "Afficher")" style="font-size: 0.8rem;">
                                                    @(visibleWhistledowns.Contains(family.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                                <span>: +@penalty pts</span>
                                            </small>
                                        }
                                        <small style="color: #666; margin-top: 5px;">
                                            @articleCount article(s) publié(s)
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "users")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">👤 Gestion des Utilisateurs</h2>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" 
                                   placeholder="🔍 Rechercher par nom, famille..." 
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   style="padding: 10px 15px; border: 2px solid #e8ebef; border-radius: 8px; min-width: 250px;" />
                            <button class="modern-btn btn-primary" @onclick="AddNewPlayer">
                                ➕ Ajouter un personnage
                            </button>
                        </div>
                    </div>
                    
                    @if (players != null && families != null)
                    {
                        var filteredPlayers = string.IsNullOrWhiteSpace(searchQuery) 
                            ? players 
                            : players.Where(p => 
                                p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                families.FirstOrDefault(f => f.Id == p.FamilyId)?.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true
                            ).ToList();

                        <div class="users-grid">
                            @foreach (var player in filteredPlayers.OrderBy(p => p.FamilyId).ThenBy(p => p.Name))
                            {
                                var playerFamily = families.FirstOrDefault(f => f.Id == player.FamilyId);
                                
                                <div class="user-card">
                                    <div class="user-card-header">
                                        <div class="user-avatar-wrapper">
                                            <img src="@player.ImageUrl" alt="@player.Name" class="user-avatar" />
                                        </div>
                                        <div class="user-info">
                                            <div class="user-name">@player.Name</div>
                                            <div class="user-title">@player.Title</div>
                                            <div class="user-family">
                                                👥 Famille @(playerFamily?.Name ?? "Inconnue")
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-body">
                                        <div class="user-detail-row">
                                            <span class="user-detail-label">Code d'accès:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="user-detail-value">
                                                    @if (visibleCodes.Contains(player.Id))
                                                    {
                                                        @player.Code
                                                    }
                                                    else
                                                    {
                                                        <span>••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleCodeVisibility(player.Id)" title="@(visibleCodes.Contains(player.Id) ? "Masquer" : "Afficher")">
                                                    @(visibleCodes.Contains(player.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                            </div>
                                        </div>
                                        <div class="user-detail-row" style="border-bottom: none;">
                                            <span class="user-detail-label">Rôle:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="user-detail-value">
                                                    @if (visibleRoles.Contains(player.Id))
                                                    {
                                                        @player.Role
                                                    }
                                                    else
                                                    {
                                                        <span>•••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleRoleVisibility(player.Id)" title="@(visibleRoles.Contains(player.Id) ? "Masquer" : "Afficher")">
                                                    @(visibleRoles.Contains(player.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-footer">
                                        <button class="icon-btn btn-primary" @onclick="() => EditUser(player)" title="Modifier">
                                            ✏️
                                        </button>
                                        <button class="icon-btn btn-primary" 
                                                @onclick="() => ToggleLadyWhistledown(player)" 
                                                title="@(player.IsLadyWhistledown ? "Retirer Lady Whistledown" : "Définir comme Lady Whistledown")">
                                            🎭
                                        </button>
                                        <button class="icon-btn btn-danger" @onclick="() => DeletePlayer(player)" title="Supprimer">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!filteredPlayers.Any())
                        {
                            <div style="text-align: center; padding: 60px 20px; color: #999;">
                                <div style="font-size: 3rem; margin-bottom: 20px;">🔍</div>
                                <p style="font-size: 1.2rem;">Aucun utilisateur trouvé</p>
                            </div>
                        }
                    }
                </div>
            }
            else if (currentTab == "families")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">👥 Gestion des Familles</h2>
                        <button class="modern-btn btn-primary" @onclick="AddNewFamily">
                            ➕ Ajouter une famille
                        </button>
                    </div>
                    
                    @if (families != null)
                    {
                        <div class="users-grid">
                            @foreach (var family in families.OrderBy(f => f.Name))
                            {
                                var familyPlayers = players?.Where(p => p.FamilyId == family.Id).ToList() ?? new List<Player>();
                                var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;
                                
                                <div class="user-card">
                                    <div class="user-card-header" style="flex-direction: column; align-items: center; text-align: center;">
                                        <div style="font-size: 3rem; margin-bottom: 10px;">👥</div>
                                        <div class="user-info" style="text-align: center;">
                                            <div class="user-name">Famille @family.Name</div>
                                            <div class="user-title">@familyPlayers.Count membre(s)</div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-body">
                                        <div class="user-detail-row">
                                            <span class="user-detail-label">Points:</span>
                                            <span class="user-detail-value">@family.Points pts</span>
                                        </div>
                                        <div class="user-detail-row">
                                            <span class="user-detail-label">Rang:</span>
                                            <span class="user-detail-value">@family.Rank / 5</span>
                                        </div>
                                        <div class="user-detail-row">
                                            <span class="user-detail-label">Vote:</span>
                                            <span class="user-detail-value">@(family.VotingEnabled ? "✅ Activé" : "❌ Désactivé")</span>
                                        </div>
                                        <div class="user-detail-row" style="border-bottom: none;">
                                            <span class="user-detail-label">Lady Whistledown:</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="user-detail-value">
                                                    @if (visibleWhistledowns.Contains(family.Id))
                                                    {
                                                        @(ladyWhistledown?.Name ?? "Non définie")
                                                    }
                                                    else
                                                    {
                                                        <span>••••••••</span>
                                                    }
                                                </span>
                                                <button class="toggle-visibility-btn" @onclick="() => ToggleWhistledownVisibility(family.Id)" title="@(visibleWhistledowns.Contains(family.Id) ? "Masquer" : "Afficher")">
                                                    @(visibleWhistledowns.Contains(family.Id) ? "👁️" : "👁️‍🗨️")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="user-card-footer">
                                        <button class="icon-btn btn-primary" @onclick="() => EditFamily(family)" title="Modifier">
                                            ✏️
                                        </button>
                                        <button class="icon-btn btn-danger" @onclick="() => DeleteFamily(family)" title="Supprimer">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!families.Any())
                        {
                            <div style="text-align: center; padding: 60px 20px; color: #999;">
                                <div style="font-size: 3rem; margin-bottom: 20px;">👥</div>
                                <p style="font-size: 1.2rem;">Aucune famille enregistrée</p>
                            </div>
                        }
                    }
                </div>
            }
            else if (currentTab == "articles")
            {
                <div class="dashboard-content">
                    <div class="section-header">
                        <h2 style="margin: 0;">📰 Gestion des Articles & Timers</h2>
                    </div>

                    @* Timer Management Section *@
                    @if (families != null)
                    {
                        <div style="margin-bottom: 40px;">
                            <div class="section-header" style="margin-bottom: 20px;">
                                <h3 style="margin: 0;">⏱️ Gestion des Timers Lady Whistledown</h3>
                            </div>
                            <div style="background: #e7f3ff; border: 2px solid #2196F3; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                                <p style="margin: 0 0 10px 0; color: #004085; font-size: 0.95rem;">
                                    <strong>ℹ️ Contrôle des timers de publication :</strong>
                                </p>
                                <ul style="margin: 0; padding-left: 20px; color: #004085; font-size: 0.95rem;">
                                    <li style="margin-bottom: 5px;">
                                        <strong>Timer par défaut :</strong> 30 minutes entre chaque publication
                                    </li>
                                    <li style="margin-bottom: 5px;">
                                        <strong>Réinitialiser :</strong> Permet une publication immédiate
                                    </li>
                                    <li>
                                        <strong>Définir manuellement :</strong> Choisir le nombre de minutes restantes avant la prochaine publication
                                    </li>
                                </ul>
                            </div>

                            <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
                                @foreach (var family in families)
                                {
                                    var articleCount = articles?.Count(a => a.FamilyId == family.Id) ?? 0;
                                    var ladyWhistledown = family.LadyWhistledownId != null ? players?.FirstOrDefault(p => p.Id == family.LadyWhistledownId) : null;

                                    <div class="info-card" style="position: relative;">
                                        <div class="info-card-header">
                                            <div class="info-card-title">Famille @family.Name</div>
                                            <span class="info-card-badge badge-info" style="background: #667eea;">
                                                @articleCount 📰
                                            </span>
                                        </div>

                                        <div style="padding: 15px;">
                                            @if (ladyWhistledown != null)
                                            {
                                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px; padding: 10px; background: rgba(102, 126, 234, 0.1); border-radius: 8px;">
                                                    <span style="font-weight: 600; color: #667eea;">🎭</span>
                                                    <span style="color: #667eea; font-weight: 600;">
                                                        @if (visibleWhistledowns.Contains(family.Id))
                                                        {
                                                            @ladyWhistledown.Name
                                                        }
                                                        else
                                                        {
                                                            <span>••••••••</span>
                                                        }
                                                    </span>
                                                    <button class="toggle-visibility-btn" @onclick="() => ToggleWhistledownVisibility(family.Id)" title="@(visibleWhistledowns.Contains(family.Id) ? "Masquer" : "Afficher")" style="margin-left: auto;">
                                                        @(visibleWhistledowns.Contains(family.Id) ? "👁️" : "👁️‍🗨️")
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="padding: 10px; background: #fff3cd; border-radius: 8px; margin-bottom: 15px; text-align: center; color: #856404;">
                                                    ⚠️ Aucune Lady Whistledown définie
                                                </div>
                                            }

                                            @* Timer Status Display (will be loaded dynamically) *@
                                            <div id="timer-status-@family.Id" style="padding: 12px; background: #f8f9fa; border-radius: 8px; margin-bottom: 15px; text-align: center;">
                                                <div style="font-size: 0.9rem; color: #666; margin-bottom: 5px;">
                                                    Chargement du statut...
                                                </div>
                                            </div>

                                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                                <button class="modern-btn btn-success" @onclick="() => ResetTimer(family.Id, family.Name)" style="font-size: 0.9rem; padding: 10px;">
                                                    🔄 Réinitialiser
                                                </button>
                                                <button class="modern-btn btn-primary" @onclick="() => ShowSetTimerDialog(family.Id, family.Name)" style="font-size: 0.9rem; padding: 10px;">
                                                    ⏱️ Définir Timer
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Articles Section *@
