@page "/admin"
@using BridgertonGame.Shared.Models
@using BridgertonGame.Shared.DTOs
@using System.Net.Http.Json
@inject ApiService ApiService
@inject AuthService AuthService
@inject HttpClient Http

<PageTitle>Admin - The Bridgerton Game</PageTitle>

<Header />

<main class="main-content">
    <div class="page-title">
        <span class="title-login">LOGIN</span>
        <h1>Administrateur</h1>
    </div>

    @if (!isAdmin)
    {
        <div class="login-section" style="max-width: 500px; margin: 50px auto; background: rgba(255, 255, 255, 0.7); padding: 40px; border-radius: 8px;">
            <div class="ornament-frame" style="margin: 0 auto 30px;">
                <img src="images/OrnementCadre.png" alt="" class="ornament-border" />
                <div class="avatar-container">
                    <img src="images/AdminAvatar.png" alt="Admin" class="admin-avatar" />
                </div>
            </div>

            <div class="login-form">
                <div style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 10px;">Login :</label>
                    <input type="text" class="form-input" style="width: 100%;" @bind="username" placeholder="Username" />
                </div>
                <div style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 10px;">Mot de passe :</label>
                    <input type="password" class="form-input" style="width: 100%;" @bind="password" @onkeypress="HandleKeyPress" placeholder="Password" />
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="error-message">@errorMessage</p>
                }
                <button class="validate-btn" style="width: 100%; margin-top: 20px;" @onclick="ValidateLogin">
                    <span class="btn-text">Se connecter</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-section">
            <div class="tabs" style="display: flex; justify-content: center; gap: 10px; margin-bottom: 30px; flex-wrap: wrap;">
                <button class="tab-btn @(currentTab == "scores" ? "active" : "")" style="padding: 10px 20px; background: @(currentTab == "scores" ? "rgba(113, 114, 197, 0.3)" : "rgba(255, 255, 255, 0.7)"); border: 2px solid #7172C5; border-radius: 8px; cursor: pointer; font-family: 'Libre Baskerville', serif;" @onclick='() => SetTab("scores")'>
                    Scores
                </button>
                <button class="tab-btn @(currentTab == "articles" ? "active" : "")" style="padding: 10px 20px; background: @(currentTab == "articles" ? "rgba(113, 114, 197, 0.3)" : "rgba(255, 255, 255, 0.7)"); border: 2px solid #7172C5; border-radius: 8px; cursor: pointer; font-family: 'Libre Baskerville', serif;" @onclick='() => SetTab("articles")'>
                    Articles
                </button>
                <button class="tab-btn @(currentTab == "voting" ? "active" : "")" style="padding: 10px 20px; background: @(currentTab == "voting" ? "rgba(113, 114, 197, 0.3)" : "rgba(255, 255, 255, 0.7)"); border: 2px solid #7172C5; border-radius: 8px; cursor: pointer; font-family: 'Libre Baskerville', serif;" @onclick='() => SetTab("voting")'>
                    Votes
                </button>
                <button class="tab-btn @(currentTab == "reveal" ? "active" : "")" style="padding: 10px 20px; background: @(currentTab == "reveal" ? "rgba(113, 114, 197, 0.3)" : "rgba(255, 255, 255, 0.7)"); border: 2px solid #7172C5; border-radius: 8px; cursor: pointer; font-family: 'Libre Baskerville', serif;" @onclick='() => SetTab("reveal")'>
                    Révéler
                </button>
            </div>

            @if (currentTab == "scores")
            {
                <div class="scores-tab" style="background: rgba(255, 255, 255, 0.7); padding: 30px; border-radius: 8px;">
                    <h2 style="font-family: 'Libre Baskerville', serif; font-style: italic; text-align: center; margin-bottom: 30px;">Gestion des Scores</h2>
                    
                    @if (families != null && gameScores != null)
                    {
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 40px;">
                            <thead>
                                <tr style="background: rgba(113, 114, 197, 0.2);">
                                    <th style="padding: 15px; text-align: left;">Jeu</th>
                                    @foreach (var family in families)
                                    {
                                        <th style="padding: 15px; text-align: center;">@family.Name</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gameScore in gameScores.Where(g => g.GameName != "Total"))
                                {
                                    <tr>
                                        <td style="padding: 12px 15px;">@gameScore.GameName</td>
                                        @foreach (var family in families)
                                        {
                                            var score = gameScore.FamilyScores.ContainsKey(family.Id) ? gameScore.FamilyScores[family.Id] : 0;
                                            <td style="padding: 12px 15px; text-align: center;">
                                                <input type="number" class="score-input" style="width: 80px; text-align: center;" value="@score" @onchange="e => UpdateScore(gameScore.GameName, family.Id, e.Value?.ToString())" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <h3 style="font-family: 'Libre Baskerville', serif; font-style: italic; margin: 30px 0 20px;">Pénalités Whistledown</h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                            @foreach (var family in families)
                            {
                                var penalty = penalties.ContainsKey(family.Id) ? penalties[family.Id] : 0;
                                <div style="display: flex; flex-direction: column; gap: 10px;">
                                    <label style="font-family: 'Times New Roman', serif;">@family.Name</label>
                                    <input type="number" class="score-input" style="width: 100%;" value="@penalty" @onchange="e => UpdatePenalty(family.Id, e.Value?.ToString())" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "articles")
            {
                <div class="articles-tab" style="background: rgba(255, 255, 255, 0.7); padding: 30px; border-radius: 8px;">
                    <h2 style="font-family: 'Libre Baskerville', serif; font-style: italic; text-align: center; margin-bottom: 30px;">Gestion des Articles</h2>
                    
                    @if (articles != null)
                    {
                        <div style="display: flex; flex-direction: column; gap: 20px;">
                            @foreach (var article in articles)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; background: rgba(113, 114, 197, 0.1); border-radius: 8px;">
                                    <div style="flex: 1;">
                                        <div style="font-weight: bold; margin-bottom: 5px;">@article.FamilyName</div>
                                        <div style="font-size: 0.9rem; color: #666; margin-bottom: 10px;">@article.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        <div style="font-style: italic;">@article.Content.Substring(0, Math.Min(100, article.Content.Length))...</div>
                                    </div>
                                    <button class="delete-btn" style="min-width: 120px; padding: 10px 20px;" @onclick="() => DeleteArticle(article.Id)">
                                        <span class="btn-text">Supprimer</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "voting")
            {
                <div class="voting-tab" style="background: rgba(255, 255, 255, 0.7); padding: 30px; border-radius: 8px;">
                    <h2 style="font-family: 'Libre Baskerville', serif; font-style: italic; text-align: center; margin-bottom: 30px;">Activer les Votes</h2>
                    
                    @if (families != null)
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            @foreach (var family in families)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; background: rgba(113, 114, 197, 0.1); border-radius: 8px;">
                                    <span style="font-family: 'Libre Baskerville', serif; font-size: 1.2rem;">@family.Name</span>
                                    <label style="display: inline-flex; align-items: center; cursor: pointer;">
                                        <input type="checkbox" checked="@family.VotingEnabled" @onchange="e => ToggleVoting(family.Id, (bool)(e.Value ?? false))" />
                                        <span style="margin-left: 10px;">@(family.VotingEnabled ? "Activé" : "Désactivé")</span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentTab == "reveal")
            {
                <div class="reveal-tab" style="background: rgba(255, 255, 255, 0.7); padding: 30px; border-radius: 8px;">
                    <h2 style="font-family: 'Libre Baskerville', serif; font-style: italic; text-align: center; margin-bottom: 30px;">Révéler Lady Whistledown</h2>
                    
                    @if (families != null)
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
                            @foreach (var family in families)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; background: rgba(113, 114, 197, 0.1); border-radius: 8px;">
                                    <span style="font-family: 'Libre Baskerville', serif; font-size: 1.2rem;">@family.Name</span>
                                    @if (family.Revealed)
                                    {
                                        <span style="color: #26b050; font-weight: bold;">Révélé</span>
                                    }
                                    else
                                    {
                                        <button class="reveal-btn" style="min-width: 100px; padding: 8px 16px;" @onclick="() => RevealWhistledown(family.Id)">
                                            <span class="btn-text" style="font-size: 0.9rem;">Révéler</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div style="text-align: center;">
                            <button class="reveal-all-btn" @onclick="RevealAll">
                                <span class="btn-text">Révéler Tout</span>
                            </button>
                        </div>
                    }
                </div>
            }

            <div style="text-align: center; margin-top: 40px;">
                <button class="logout-btn" @onclick="Logout">
                    <span class="btn-text">Déconnexion</span>
                </button>
            </div>
        </div>
    }
</main>

@code {
    private bool isAdmin = false;
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private string currentTab = "scores";

    private List<Family>? families;
    private List<GameScore>? gameScores;
    private List<Article>? articles;
    private Dictionary<string, int> penalties = new();

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await AuthService.IsAdminAuthenticatedAsync();
        if (isAdmin)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        families = await ApiService.GetAllFamiliesAsync();
        gameScores = await ApiService.GetAllGameScoresAsync();
        articles = await ApiService.GetAllArticlesAsync();
        penalties = await ApiService.GetPenaltiesAsync();
    }

    private async Task ValidateLogin()
    {
        var request = new AdminLoginRequest { Username = username, Password = password };
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/admin", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AdminLoginResponse>();
                if (result?.Success == true)
                {
                    isAdmin = true;
                    await AuthService.SetAdminAuthenticatedAsync(true);
                    await LoadData();
                    errorMessage = "";
                }
                else
                {
                    errorMessage = result?.ErrorMessage ?? "Erreur de connexion";
                }
            }
            else
            {
                errorMessage = "Login ou mot de passe incorrect";
            }
        }
        catch
        {
            errorMessage = "Erreur de connexion";
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ValidateLogin();
        }
    }

    private void SetTab(string tab)
    {
        currentTab = tab;
    }

    private async Task UpdateScore(string gameName, string familyId, string? value)
    {
        if (int.TryParse(value, out int points) && gameScores != null)
        {
            var game = gameScores.FirstOrDefault(g => g.GameName == gameName);
            if (game != null)
            {
                game.FamilyScores[familyId] = points;
                await Http.PutAsJsonAsync("api/gamescores", game);
            }
        }
    }

    private async Task UpdatePenalty(string familyId, string? value)
    {
        if (int.TryParse(value, out int penalty))
        {
            penalties[familyId] = penalty;
            await Http.PutAsJsonAsync($"api/gamescores/penalties/{familyId}", penalty);
        }
    }

    private async Task DeleteArticle(string articleId)
    {
        await Http.DeleteAsync($"api/articles/{articleId}");
        await LoadData();
    }

    private async Task ToggleVoting(string familyId, bool enabled)
    {
        await Http.PostAsJsonAsync($"api/families/{familyId}/toggle-voting", enabled);
        await LoadData();
    }

    private async Task RevealWhistledown(string familyId)
    {
        await Http.PostAsync($"api/families/{familyId}/reveal", null);
        await LoadData();
    }

    private async Task RevealAll()
    {
        await Http.PostAsync("api/families/reveal-all", null);
        await LoadData();
    }

    private async Task Logout()
    {
        await AuthService.SetAdminAuthenticatedAsync(false);
        isAdmin = false;
        username = "";
        password = "";
        errorMessage = "";
    }
}
