@if (showEditQuestionModal && editingQuestion != null)
{
    <div class="modal-overlay" @onclick="CloseEditQuestionModal">
        <div class="modal-container" @onclick:stopPropagation="true" style="max-width: 700px;">
            <div class="modal-header">
                <h3>@(isCreatingQuestion ? "➕ Créer une question" : "✏️ Modifier la question")</h3>
                <button class="modal-close-btn" @onclick="CloseEditQuestionModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Numéro de la question</label>
                    <input type="number" @bind="editingQuestion.QuestionNumber" class="form-control" placeholder="Ex: 1" min="1" />
                </div>
                <div class="form-group">
                    <label>Question</label>
                    <textarea @bind="editingQuestion.Question" class="form-control" rows="3" placeholder="Entrez la question..."></textarea>
                </div>
                <div class="form-group">
                    <label>Option A</label>
                    <input type="text" @bind="editingQuestion.OptionA" class="form-control" placeholder="Réponse A" />
                </div>
                <div class="form-group">
                    <label>Option B</label>
                    <input type="text" @bind="editingQuestion.OptionB" class="form-control" placeholder="Réponse B" />
                </div>
                <div class="form-group">
                    <label>Option C</label>
                    <input type="text" @bind="editingQuestion.OptionC" class="form-control" placeholder="Réponse C" />
                </div>
                <div class="form-group">
                    <label>Option D</label>
                    <input type="text" @bind="editingQuestion.OptionD" class="form-control" placeholder="Réponse D" />
                </div>
                <div class="form-group">
                    <label>Bonne réponse</label>
                    <select @bind="editingQuestion.CorrectAnswer" class="form-control">
                        <option value="">-- Sélectionner la bonne réponse --</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(questionValidationError))
                {
                    <div style="background: #fee; color: #c33; padding: 15px; border-radius: 8px; margin-top: 15px;">
                        <strong>⚠️</strong> @questionValidationError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="modern-btn btn-outline" @onclick="CloseEditQuestionModal">Annuler</button>
                <button class="modern-btn btn-primary" @onclick="SaveQuestion" disabled="@(!IsQuestionValid())">
                    @(isCreatingQuestion ? "➕ Créer" : "💾 Enregistrer")
                </button>
            </div>
        </div>
    </div>
}

@if (showSetTimerDialog)
{
    <div class="modal-overlay" @onclick="CloseSetTimerDialog">
        <div class="modal-container" @onclick:stopPropagation="true" style="max-width: 500px;">
            <div class="modal-header">
                <h3>⏱️ Définir le Timer</h3>
                <button class="modal-close-btn" @onclick="CloseSetTimerDialog">✕</button>
            </div>
            <div class="modal-body">
                <div style="background: #e7f3ff; border: 2px solid #2196F3; border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                    <p style="margin: 0; color: #004085; font-size: 0.95rem;">
                        <strong>🎭 Famille @timerFamilyName</strong>
                    </p>
                </div>

                <div class="form-group">
                    <label style="font-weight: 600; margin-bottom: 10px; display: block;">
                        Minutes restantes avant la prochaine publication:
                    </label>
                    <input type="number" 
                           @bind="timerMinutes" 
                           class="form-control" 
                           placeholder="Ex: 15" 
                           min="0" 
                           max="60" 
                           style="font-size: 1.2rem; text-align: center; padding: 15px;" />
                    <small style="display: block; margin-top: 10px; color: #666; text-align: center;">
                        Entrez un nombre entre 0 (publication immédiate) et 60 minutes
                    </small>
                </div>

                <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 12px; margin-top: 15px;">
                    <div style="display: flex; align-items: start; gap: 10px;">
                        <span style="font-size: 1.2rem;">ℹ️</span>
                        <div>
                            <strong style="color: #856404;">Exemples :</strong>
                            <ul style="margin: 5px 0 0 0; padding-left: 20px; color: #856404; font-size: 0.9rem;">
                                <li><strong>0 min</strong> : Publication immédiate possible</li>
                                <li><strong>15 min</strong> : Peut publier dans 15 minutes</li>
                                <li><strong>30 min</strong> : Durée normale du cooldown</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modern-btn btn-outline" @onclick="CloseSetTimerDialog">Annuler</button>
                <button class="modern-btn btn-primary" @onclick="ConfirmSetTimer">
                    ✅ Confirmer
                </button>
            </div>
        </div>
    </div>
}
