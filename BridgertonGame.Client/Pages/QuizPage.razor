@page "/quiz"
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Quiz - The Bridgerton Game</PageTitle>

<Header />

<Hero TitlePrefix="LE" Title="Quiz" BackgroundImage="images/hero-monespace.jpg" />

<main class="main-content">
    @if (currentPlayer == null)
    {
        <!-- Rediriger vers l'espace personnel si non connecté -->
        <div style="text-align: center; padding: 40px;">
            <p style="font-size: 1.2rem; margin-bottom: 20px;">Vous devez être connecté pour accéder au quiz.</p>
            <button class="modern-btn primary-btn" @onclick="GoToMonEspace">
                Se connecter
            </button>
        </div>
    }
    else if (quizState?.IsEnabled != true)
    {
        <!-- Quiz désactivé -->
        <div style="text-align: center; padding: 40px;">
            <div style="font-size: 3rem; margin-bottom: 20px;">📝</div>
            <h2 style="font-family: 'Libre Baskerville', serif; font-size: 2rem; margin-bottom: 15px;">Quiz non disponible</h2>
            <p style="font-size: 1.1rem; color: #666;">Le quiz n'est pas encore activé. Revenez plus tard !</p>
        </div>
    }
    else if (currentQuestion == null)
    {
        <!-- Pas de question active -->
        <div style="text-align: center; padding: 40px;">
            <div style="font-size: 3rem; margin-bottom: 20px;">⏳</div>
            <h2 style="font-family: 'Libre Baskerville', serif; font-size: 2rem; margin-bottom: 15px;">En attente de questions</h2>
            <p style="font-size: 1.1rem; color: #666;">Aucune question n'est disponible pour le moment.</p>
        </div>
    }
    else
    {
        <!-- Quiz actif -->
        <div class="modern-profile-section">
            <div class="modern-card" style="max-width: 800px; margin: 0 auto;">
                <div class="card-header">
                    <div class="header-icon">📝</div>
                    <h3>Question @currentQuestion.QuestionNumber</h3>
                </div>
                <div class="card-body">
                    @if (currentPlayerAnswer != null)
                    {
                        <!-- Affichage de la réponse déjà donnée -->
                        <div style="background: #e7f3ff; border-left: 4px solid #2196F3; padding: 20px; border-radius: 8px; text-align: center;">
                            <div style="font-size: 1.1rem; color: #1976D2; margin-bottom: 15px;">
                                ✅ <strong>Vous avez déjà répondu à cette question !</strong>
                            </div>
                            <div style="padding: 15px; background: white; border-radius: 8px; margin-bottom: 15px;">
                                <p style="font-weight: 600; color: #2c3e50; margin-bottom: 15px; font-size: 1.1rem;">@currentQuestion.Question</p>
                                <div style="padding: 10px; background: #f8f9fa; border-radius: 5px; border-left: 3px solid #2196F3;">
                                    <strong>Votre réponse:</strong> <span style="color: #1565C0; font-weight: bold;">@currentPlayerAnswer.SelectedAnswer</span>
                                </div>
                            </div>
                            <div style="font-size: 0.9rem; color: #555;">
                                💡 <em>Répondu le @currentPlayerAnswer.AnsweredAt.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</em>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Formulaire de réponse -->
                        <div style="padding: 15px;">
                            <p style="font-weight: 600; color: #2c3e50; margin-bottom: 20px; font-size: 1.2rem;">@currentQuestion.Question</p>
                            
                            <div style="display: grid; gap: 10px; margin-bottom: 20px;">
                                @foreach (var option in new[] { 
                                    new { Letter = "A", Text = currentQuestion.OptionA },
                                    new { Letter = "B", Text = currentQuestion.OptionB },
                                    new { Letter = "C", Text = currentQuestion.OptionC },
                                    new { Letter = "D", Text = currentQuestion.OptionD }
                                })
                                {
                                    <label class="quiz-option @(selectedQuizAnswer == option.Letter ? "selected" : "")" 
                                           @onclick="() => selectedQuizAnswer = option.Letter">
                                        <input type="radio" 
                                               name="quiz-answer" 
                                               value="@option.Letter" 
                                               checked="@(selectedQuizAnswer == option.Letter)"
                                               style="margin-right: 10px;" />
                                        <span><strong>@option.Letter.</strong> @option.Text</span>
                                    </label>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div style="background: #fee; color: #c33; padding: 15px; border-radius: 8px; margin-bottom: 15px; text-align: center;">
                                    <strong>⚠️</strong> @errorMessage
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 15px; text-align: center;">
                                    <strong>✅</strong> @successMessage
                                </div>
                            }
                            
                            <button class="modern-btn primary-btn" 
                                    style="width: 100%;"
                                    disabled="@(string.IsNullOrEmpty(selectedQuizAnswer))" 
                                    @onclick="SubmitQuizAnswer">
                                Valider ma réponse
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Bouton retour -->
            <div style="text-align: center; margin-top: 30px;">
                <button class="modern-btn" @onclick="GoToMonEspace">
                    ← Retour à mon espace
                </button>
            </div>
        </div>
    }
</main>
