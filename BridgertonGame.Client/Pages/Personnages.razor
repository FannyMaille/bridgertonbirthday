@page "/personnages"
@using BridgertonGame.Shared.Models
@using BridgertonGame.Client.Shared

<PageTitle>Personnages - The Bridgerton Game</PageTitle>

<Header />

<Hero TitlePrefix="THE" Title="Personnages" BackgroundImage="images/hero-personnages.jpg" />

<main class="main-content">
    @if (families == null || players == null)
    {
        <p>Chargement...</p>
    }
    else
    {
        @if (hostPlayer != null)
        {
            <div class="modern-host-section">
                <div class="host-card-modern">
                    <div class="host-badge">
                        <span>⭐ Hôte du Bal ⭐</span>
                    </div>
                    <div class="host-frame-wrapper">
                        <img src="@hostPlayer.ImageUrl" alt="@hostPlayer.Name" class="host-image-large" @onclick="() => ShowImageModal(hostPlayer.ImageUrl)" />
                    </div>
                    <div class="host-info-modern">
                        <div class="host-title-text">@hostPlayer.Title</div>
                        <div class="host-name-text">@hostPlayer.Name</div>
                    </div>
                </div>
            </div>
        }

        <div class="families-container-modern">
            @foreach (var family in families)
            {
                var familyMembers = players.Where(p => p.FamilyId == family.Id && p.Id != hostPlayer?.Id).ToList();
                
                <div class="family-section-modern">
                    <div class="family-divider section-divider">
                        <div class="flower-line">
                            <img src="images/Ornement.png" alt="" />
                        </div>
                        <h3 class="family-name-title">Famille @family.Name</h3>
                        <div class="flower-line">
                            <img src="images/Ornement.png" alt="" />
                        </div>
                    </div>

                    <div class="characters-grid-modern">
                        @foreach (var member in familyMembers)
                        {
                            <div class="character-card-modern">
                                <div class="character-card-inner">
                                    <div class="character-image-wrapper-large">
                                        <img src="@member.ImageUrl" alt="@member.Name" class="character-image-large" @onclick="() => ShowImageModal(member.ImageUrl)" />
                                    </div>
                                    <div class="character-info-modern">
                                        <div class="character-title-text">@member.Title</div>
                                        <div class="character-name-text">@member.Name</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (showModal)
    {
        <div class="image-modal-overlay" @onclick="CloseImageModal">
            <div class="image-modal-container" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseImageModal">✕</button>
                <img src="@selectedImage" alt="Agrandir" class="modal-image" />
            </div>
        </div>
    }
</main>
