@page "/mon-espace"
@using BridgertonGame.Client.Shared
@using BridgertonGame.Shared.Models
@using BridgertonGame.Shared.DTOs
@using System.Net.Http.Json
@inject ApiService ApiService
@inject AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Mon Espace - The Bridgerton Game</PageTitle>

<Header />

<Hero TitlePrefix="MON" Title="Espace" BackgroundImage="images/hero-monespace.jpg" />

<main class="main-content">
    @if (currentPlayer == null)
    {
        <!-- Login Section Moderne -->
        <div class="modern-login-section">
            <div class="login-card-modern">
                <div class="login-icon">
                    <img src="images/LadyWithldown.png" alt="Login" />
                </div>
                <h2 class="login-title">Bienvenue</h2>
                <p class="login-subtitle">Entre ton code personnel</p>
                
                <div class="login-form-modern">
                    <input type="text" 
                           class="code-input-modern" 
                           @bind="playerCode" 
                           @onkeypress="HandleKeyPress" 
                           placeholder="CODE" 
                           autocomplete="off" />
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert-message">
                            <span>@errorMessage</span>
                        </div>
                    }
                    
                    <button class="validate-btn-modern" @onclick="ValidateCode">
                        Valider
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Profile Section Moderne -->
        <div class="modern-profile-section">
            
            <!-- Player Card -->
            <div class="player-card-modern">
                <div class="player-image-wrapper">
                    <img src="@currentPlayer.ImageUrl" alt="@currentPlayer.Name" class="player-avatar" @onclick="() => ShowImageModal(currentPlayer.ImageUrl)" />
                </div>
                <div class="player-details">
                    <span class="player-title-small">@currentPlayer.Title</span>
                    <h2 class="player-name-large">@currentPlayer.Name</h2>
                    <div class="player-role-toggle">
                        <span class="role-label">Rôle:</span>
                        <span class="role-value">@(showRole ? currentPlayer.Role : "•••••••")</span>
                        <button class="toggle-role-btn" @onclick="ToggleRoleVisibility">
                            @(showRole ? "🙈" : "👁️")
                        </button>
                    </div>
                </div>
            </div>

            @if (currentFamily != null)
            {
                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card stat-rank">
                        <div class="stat-icon">🏆</div>
                        <div class="stat-content">
                            <span class="stat-label">Classement</span>
                            <span class="stat-value">@GetRankText(currentFamily.Rank)</span>
                        </div>
                    </div>
                    <div class="stat-card stat-points">
                        <div class="stat-icon">⭐</div>
                        <div class="stat-content">
                            <span class="stat-label">Points</span>
                            <span class="stat-value">@currentFamily.Points</span>
                        </div>
                    </div>
                </div>

                <!-- Family Section -->
                <div class="section-divider">
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                    <h3>Ma Famille<br/>@currentFamily.Name</h3>
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                </div>

                <div class="characters-grid-modern">
                    @foreach (var member in familyMembers)
                    {
                        <div class="character-card-modern">
                            <div class="character-card-inner">
                                <div class="character-image-wrapper-large">
                                    <img src="@member.ImageUrl" alt="@member.Name" class="character-image-large" @onclick="() => ShowImageModal(member.ImageUrl)" />
                                </div>
                                <div class="character-info-modern">
                                    <div class="character-title-text">@member.Title</div>
                                    <div class="character-name-text">@member.Name</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Voting Section -->
                @if (currentFamily.VotingEnabled)
                {
                    <div class="modern-card voting-card">
                        <div class="card-header">
                            <div class="header-icon">🗳️</div>
                            <h3>Vote pour Lady Whistledown</h3>
                        </div>
                        <div class="card-body">
                            <select class="modern-select" @bind="selectedMemberId">
                                <option value="">Sélectionne un nom</option>
                                @foreach (var member in familyMembers)
                                {
                                    <option value="@member.Id">@member.Name</option>
                                }
                            </select>
                            <button class="modern-btn primary-btn" 
                                    disabled="@(string.IsNullOrEmpty(selectedMemberId))" 
                                    @onclick="ConfirmVote">
                                Confirmer mon vote
                            </button>
                        </div>
                    </div>
                }

                <!-- Publication Section -->
                @if (currentPlayer.IsLadyWhistledown)
                {
                    <div class="modern-card publication-card">
                        <div class="card-header">
                            <div class="header-icon">✍️</div>
                            <h3>Publier une Chronique</h3>
                        </div>
                        <div class="card-body">
                            <div class="editor-wrapper">
                                <textarea class="modern-textarea" 
                                          maxlength="300" 
                                          @bind="articleContent" 
                                          @oninput="UpdateCharCount" 
                                          placeholder="Écris ta chronique mondaine..."></textarea>
                                <div class="char-counter">@charCount / 300</div>
                            </div>
                            
                            @if (timeUntilNext.HasValue && timeUntilNext.Value > TimeSpan.Zero)
                            {
                                <div class="cooldown-alert">
                                    <span class="alert-icon">⏱️</span>
                                    <span>Prochaine publication dans @FormatTimeRemaining(timeUntilNext.Value)</span>
                                </div>
                            }
                            
                            <div class="publish-footer">
                                <span class="family-badge">Famille @currentFamily.Name</span>
                                <button class="modern-btn primary-btn" 
                                        disabled="@(!CanPublish())" 
                                        @onclick="PublishArticle">
                                    Publier
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Logout Button -->
                <div class="logout-section">
                    <button class="modern-btn logout-btn" @onclick="Logout">
                        <span>🚪</span> Déconnexion
                    </button>
                </div>
            }
        </div>
    }

    @if (showModal)
    {
        <div class="image-modal-overlay" @onclick="CloseImageModal">
            <div class="image-modal-container" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseImageModal">✕</button>
                <img src="@selectedImage" alt="Agrandir" class="modal-image" />
            </div>
        </div>
    }
</main>

@code {
    private Player? currentPlayer;
    private Family? currentFamily;
    private List<Player> familyMembers = new();
    private string playerCode = "";
    private string errorMessage = "";
    private bool showRole = false;
    private string selectedMemberId = "";
    private string articleContent = "";
    private int charCount = 0;
    private TimeSpan? timeUntilNext;
    private System.Threading.Timer? cooldownTimer;
    private bool showModal = false;
    private string selectedImage = "";

    protected override async Task OnInitializedAsync()
    {
        currentPlayer = await AuthService.GetCurrentPlayerAsync();
        if (currentPlayer != null)
        {
            await LoadPlayerData();
        }
    }

    private async Task LoadPlayerData()
    {
        if (currentPlayer == null) return;

        currentFamily = await ApiService.GetFamilyByIdAsync(currentPlayer.FamilyId);
        familyMembers = await ApiService.GetPlayersByFamilyAsync(currentPlayer.FamilyId);
        
        if (currentPlayer.IsLadyWhistledown)
        {
            await CheckCooldown();
        }
    }

    private async Task ValidateCode()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(playerCode))
        {
            errorMessage = "Veuillez entrer un code";
            return;
        }

        var player = await ApiService.GetPlayerByCodeAsync(playerCode);
        if (player != null)
        {
            currentPlayer = player;
            await AuthService.SetCurrentPlayerAsync(player);
            await LoadPlayerData();
        }
        else
        {
            errorMessage = "Code invalide. Veuillez réessayer.";
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ValidateCode();
        }
    }

    private void ToggleRoleVisibility()
    {
        showRole = !showRole;
    }

    private string GetRankText(int rank) => rank switch
    {
        1 => "1er",
        2 => "2ème",
        3 => "3ème",
        4 => "4ème",
        5 => "5ème",
        _ => $"{rank}ème"
    };

    private async Task ConfirmVote()
    {
        if (string.IsNullOrEmpty(selectedMemberId) || currentFamily == null) return;

        try
        {
            var request = new VoteRequest { FamilyId = currentFamily.Id, PlayerId = selectedMemberId };
            await Http.PostAsJsonAsync($"api/families/{currentFamily.Id}/vote", request);
            errorMessage = "Votre vote a été enregistré !";
        }
        catch
        {
            errorMessage = "Erreur lors de l'enregistrement du vote.";
        }
    }

    private void UpdateCharCount(ChangeEventArgs e)
    {
        articleContent = e.Value?.ToString() ?? "";
        charCount = articleContent.Length;
    }

    private bool CanPublish()
    {
        return !string.IsNullOrWhiteSpace(articleContent) && 
               (!timeUntilNext.HasValue || timeUntilNext.Value <= TimeSpan.Zero);
    }

    private async Task PublishArticle()
    {
        if (!CanPublish() || currentFamily == null) return;

        try
        {
            var request = new PublishArticleRequest
            {
                Title = "Chers amis lecteurs,",
                Content = articleContent,
                FamilyId = currentFamily.Id
            };

            var response = await Http.PostAsJsonAsync("api/articles", request);
            if (response.IsSuccessStatusCode)
            {
                articleContent = "";
                charCount = 0;
                await CheckCooldown();
                errorMessage = "Votre article a été publié !";
            }
        }
        catch
        {
            errorMessage = "Erreur lors de la publication.";
        }
    }

    private async Task CheckCooldown()
    {
        if (currentFamily == null) return;

        try
        {
            var response = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/articles/can-publish/{currentFamily.Id}");
            var canPublish = response.GetProperty("canPublish").GetBoolean();
            if (!canPublish && response.TryGetProperty("timeRemaining", out System.Text.Json.JsonElement timeRemainingProp))
            {
                var timeRemainingStr = timeRemainingProp.GetString();
                if (!string.IsNullOrEmpty(timeRemainingStr))
                {
                    timeUntilNext = TimeSpan.Parse(timeRemainingStr);
                    StartCooldownTimer();
                }
            }
            else
            {
                timeUntilNext = null;
            }
        }
        catch { }
    }

    private void StartCooldownTimer()
    {
        cooldownTimer?.Dispose();
        cooldownTimer = new System.Threading.Timer(async _ =>
        {
            if (timeUntilNext.HasValue && timeUntilNext.Value > TimeSpan.Zero)
            {
                timeUntilNext = timeUntilNext.Value.Subtract(TimeSpan.FromSeconds(1));
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                cooldownTimer?.Dispose();
                timeUntilNext = null;
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private string FormatTimeRemaining(TimeSpan time)
    {
        return $"{time.Minutes:D2}:{time.Seconds:D2}";
    }

    private void ShowImageModal(string imageUrl)
    {
        selectedImage = imageUrl;
        showModal = true;
    }

    private void CloseImageModal()
    {
        showModal = false;
        selectedImage = "";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        currentPlayer = null;
        currentFamily = null;
        showRole = false;
        selectedMemberId = "";
        articleContent = "";
        playerCode = "";
        errorMessage = "";
        cooldownTimer?.Dispose();
    }

    public void Dispose()
    {
        cooldownTimer?.Dispose();
    }
}
