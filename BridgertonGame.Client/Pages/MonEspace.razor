@page "/mon-espace"

<PageTitle>Mon Espace - The Bridgerton Game</PageTitle>

<link href="css/mon-espace-responsive.css" rel="stylesheet" />

<Header />

<Hero TitlePrefix="MON" Title="Espace" BackgroundImage="images/hero-monespace.jpg" />

<main class="main-content">
    @if (currentPlayer == null)
    {
        <!-- Login Section Moderne -->
        <div class="modern-login-section">
            <div class="login-card-modern">
                <div class="login-icon">
                    <img src="images/LadyWithldown.png" alt="Login" />
                </div>
                <h2 class="login-title">Bienvenue</h2>
                <p class="login-subtitle">Entre ton code personnel</p>
                
                <div class="login-form-modern">
                    <input type="text" 
                           class="code-input-modern" 
                           @bind="playerCode" 
                           @onkeypress="HandleKeyPress" 
                           placeholder="CODE" 
                           autocomplete="off" />
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert-message">
                            <span>@errorMessage</span>
                        </div>
                    }
                    
                    <button class="validate-btn-modern" @onclick="ValidateCode">
                        Valider
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Profile Section Moderne -->
        <div class="modern-profile-section">
            
            <!-- Player Card -->
            <div class="player-card-modern">
                <div class="player-image-wrapper">
                    <img src="@currentPlayer.ImageUrl" alt="@currentPlayer.Name" class="player-avatar" @onclick="() => ShowImageModal(currentPlayer.ImageUrl)" />
                </div>
                <div class="player-details">
                    <span class="player-title-small">@currentPlayer.Title</span>
                    <h2 class="player-name-large">@currentPlayer.Name</h2>
                    <div class="player-role-toggle">
                        <span class="role-label">Rôle:</span>
                        <span class="role-value">@(showRole ? currentPlayer.Role : "•••••••")</span>
                        <button class="toggle-role-btn" @onclick="ToggleRoleVisibility">
                            @(showRole ? "🙈" : "👁️")
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background: #fee; color: #c33; padding: 20px; border-radius: 10px; margin: 20px 0; text-align: center;">
                    <strong>⚠️ Erreur:</strong> @errorMessage
                </div>
            }

            @if (currentPlayer.Role == "Maîtresse de maison")
            {
                <!-- Message spécial pour la Maîtresse de maison -->
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px; border-radius: 15px; text-align: center; margin: 30px 0;">
                    <div style="font-size: 3rem; margin-bottom: 20px;">👑</div>
                    <h2 style="font-family: 'Libre Baskerville', serif; font-size: 2rem; margin-bottom: 15px;">Hôte du Bal</h2>
                    <p style="font-size: 1.2rem; opacity: 0.9;">
                        Bienvenue, @currentPlayer.Name !<br/>
                        Vous êtes l'hôte de cet événement prestigieux.
                    </p>
                </div>
            }
            else if (currentFamily != null)
            {
                <!-- Quiz Section -->
                @if (quizState?.IsEnabled == true && quizState.CurrentQuestionNumber > 0)
                {
                    <div class="modern-card" style="margin-top: 30px;">
                        <div class="card-header">
                            <div class="header-icon">📝</div>
                            <h3>Quiz disponible</h3>
                        </div>
                        <div class="card-body" style="text-align: center; padding: 30px;">
                            <p style="font-size: 1.1rem; margin-bottom: 20px; color: #2c3e50;">
                                @if (currentPlayerAnswer != null)
                                {
                                    <span>✅ Vous avez répondu à la question @currentQuestion?.QuestionNumber</span>
                                }
                                else
                                {
                                    <span>Une nouvelle question vous attend !</span>
                                }
                            </p>
                            <button class="modern-btn primary-btn"
                                    style="font-size: 1.1rem; padding: 15px 40px;"
                                    @onclick="GoToQuiz">
                                @if (currentPlayerAnswer != null)
                                {
                                    <span>Voir ma réponse</span>
                                }
                                else
                                {
                                    <span>Répondre au quiz 📝</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                <!-- Stats Cards -->
                <div class="section-divider" style="margin-top: 40px;">
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                    <h3>Les points de<br />Ma Famille</h3>
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                </div>
                <div class="stats-grid">
                    <div class="stat-card stat-rank">
                        <div class="stat-icon">🏆</div>
                        <div class="stat-content">
                            <span class="stat-label">Classement</span>
                            <span class="stat-value">@GetRankText(currentFamily.Rank)</span>
                        </div>
                    </div>
                    <div class="stat-card stat-points">
                        <div class="stat-icon">⭐</div>
                        <div class="stat-content">
                            <span class="stat-label">Points</span>
                            <span class="stat-value">@currentFamily.Points</span>
                        </div>
                    </div>
                </div>

                <!-- Voting Section -->
                @if (currentFamily.VotingEnabled && !currentFamily.Revealed)
                {
                    <div class="modern-card">
                        <div class="card-header">
                            <div class="header-icon">🗳️</div>
                            <h3>Vote pour Lady Whistledown</h3>
                        </div>
                        <div class="card-body">
                            @if (currentPlayer.IsLadyWhistledown)
                            {
                                <!-- Message pour les Lady Whistledown -->
                                <div style="background: rgba(245, 87, 108, 0.1); border: 2px solid #f5576c; padding: 20px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 2.5rem; margin-bottom: 10px;">🤫</div>
                                    <div style="font-size: 1.2rem; font-weight: bold; color: #f5576c; margin-bottom: 10px;">
                                        Vous êtes Lady Whistledown !
                                    </div>
                                    <div style="font-size: 0.95rem; color: #666; line-height: 1.5;">
                                        Les Lady Whistledown ne peuvent pas voter.<br/>
                                        Vous connaissez déjà le secret de votre famille... 😉
                                    </div>
                                </div>
                            }
                            else if (hasVoted)
                            {
                                <!-- Affichage du vote existant -->
                                <div style="background: #e7f3ff; border-left: 4px solid #2196F3; padding: 20px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 1.1rem; color: #1976D2; margin-bottom: 10px;">
                                        ✅ <strong>Vous avez déjà voté !</strong>
                                    </div>
                                    <div style="font-size: 1.3rem; font-weight: bold; color: #0D47A1; margin-top: 15px;">
                                        Votre vote : <span style="color: #1565C0;">@existingVoteForName</span>
                                    </div>
                                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #90CAF9; font-size: 0.9rem; color: #555;">
                                        💡 <em>Votre vote sera comptabilisé lors de la révélation</em>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Formulaire de vote -->
                                <select class="modern-select" @bind="selectedMemberId">
                                    <option value="">Sélectionne un nom</option>
                                    @foreach (var member in familyMembers)
                                    {
                                        <option value="@member.Id">@member.Name</option>
                                    }
                                </select>
                                <button class="modern-btn primary-btn"
                                        disabled="@(string.IsNullOrEmpty(selectedMemberId))"
                                        @onclick="ConfirmVote">
                                    Confirmer mon vote
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Family Section -->
                <div class="section-divider">
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                    <h3>Ma Famille<br/>@currentFamily.Name</h3>
                    <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                </div>

                <div class="characters-grid-modern">
                    @foreach (var member in familyMembers)
                    {
                        <div class="character-card-modern">
                            <div class="character-card-inner">
                                <div class="character-image-wrapper-large">
                                    <img src="@member.ImageUrl" alt="@member.Name" class="character-image-large" @onclick="() => ShowImageModal(member.ImageUrl)" />
                                </div>
                                <div class="character-info-modern">
                                    <div class="character-title-text">@member.Title</div>
                                    <div class="character-name-text">@member.Name</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Publication Section -->
                @if (currentPlayer.IsLadyWhistledown)
                {
                    <div class="modern-card publication-card">
                        <div class="card-header">
                            <div class="header-icon">✍️</div>
                            <h3>Publier une Chronique</h3>
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">
                                <div class="warning-notice" style="background: #fff3cd; border-left: 4px solid #ffc107; padding: 12px; border-radius: 4px;">
                                    <strong>⚠️ Famille :</strong> Chaque publication = <strong>-10 points</strong>
                                </div>
                                <div class="success-notice" style="background: #d4edda; border-left: 4px solid #28a745; padding: 12px; border-radius: 4px;">
                                    <strong>✨ Vous :</strong> Chaque publication = <strong>+10 points</strong>
                                </div>
                            </div>
                            <div style="text-align: center; padding: 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px; margin-bottom: 15px;">
                                <div style="font-size: 0.9rem; opacity: 0.9;">Vos points personnels</div>
                                <div style="font-size: 2.5rem; font-weight: bold; font-family: 'Libre Baskerville', serif;">@playerPoints pts</div>
                                <div style="font-size: 0.85rem; opacity: 0.9;">Lady Whistledown</div>
                            </div>
                            <div class="editor-wrapper">
                                <textarea class="modern-textarea" 
                                          maxlength="300" 
                                          @bind="articleContent" 
                                          @oninput="UpdateCharCount" 
                                          placeholder="Écris ta chronique mondaine..."></textarea>
                                <div class="char-counter">@charCount / 300</div>
                            </div>
                            
                            @if (timeUntilNext.HasValue && timeUntilNext.Value > TimeSpan.Zero)
                            {
                                <div class="cooldown-alert">
                                    <span class="alert-icon">⏱️</span>
                                    <span>Prochaine publication dans @FormatTimeRemaining(timeUntilNext.Value)</span>
                                </div>
                            }
                            
                            <div class="publish-footer">
                                <span class="family-badge">Famille @currentFamily.Name</span>
                                <button class="modern-btn primary-btn" 
                                        disabled="@(!CanPublish())" 
                                        @onclick="PublishArticle">
                                    Publier
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Team Whistledown Stats Section -->
                    <div class="section-divider" style="margin-top: 40px;">
                        <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                        <h3>Équipe<br/>Lady Whistledown</h3>
                        <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                    </div>

                    <div class="stats-grid" style="margin-bottom: 40px;">
                        <div class="stat-card stat-rank">
                            <div class="stat-icon">🏆</div>
                            <div class="stat-content">
                                <span class="stat-label">Classement</span>
                                <span class="stat-value">@GetRankText(teamWhistledownRank)</span>
                            </div>
                        </div>
                        <div class="stat-card stat-points">
                            <div class="stat-icon">⭐</div>
                            <div class="stat-content">
                                <span class="stat-label">Points</span>
                                <span class="stat-value">@teamWhistledownPoints</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Lady Whistledown Chat Section -->
                    <div class="section-divider" style="margin-top: 40px;">
                        <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                        <h3>Salon Secret des<br/>Lady Whistledown</h3>
                        <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                    </div>

                    <div class="modern-card" style="margin-bottom: 40px;">
                        <LadyWhistledownChat CurrentPlayerId="@currentPlayer.Id" />
                    </div>
                    
                    <!-- Lady Whistledown Section - Afficher les autres Lady Whistledown -->
                    @if (otherLadyWhistledowns.Any())
                    {
                        <div class="section-divider">
                            <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                            <h3>Les Autres<br/>Lady Whistledown</h3>
                            <div class="flower-line"><img src="images/Ornement.png" alt="" /></div>
                        </div>

                        <div class="characters-grid-modern">
                            @foreach (var whistledown in otherLadyWhistledowns)
                            {
                                var family = allFamilies.FirstOrDefault(f => f.Id == whistledown.FamilyId);
                                <div class="character-card-modern">
                                    <div class="character-card-inner">
                                        <div class="character-image-wrapper-large">
                                            <img src="@whistledown.ImageUrl" alt="@whistledown.Name" class="character-image-large" @onclick="() => ShowImageModal(whistledown.ImageUrl)" />
                                        </div>
                                        <div class="character-info-modern">
                                            <div class="character-title-text">@whistledown.Title</div>
                                            <div class="character-name-text">@whistledown.Name</div>
                                            @if (family != null)
                                            {
                                                <div style="margin-top: 8px; padding: 6px 12px; background: rgba(113, 114, 197, 0.1); border-radius: 8px; font-size: 0.9rem; color: #7172C5;">
                                                    Famille @family.Name
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- Logout Button -->
                <div class="logout-section">
                    <button class="modern-btn logout-btn" @onclick="Logout">
                        <span>🚪</span> Déconnexion
                    </button>
                </div>
            }
        </div>
    }

    @if (showModal)
    {
        <div class="image-modal-overlay" @onclick="CloseImageModal">
            <div class="image-modal-container" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseImageModal">✕</button>
                <img src="@selectedImage" alt="Agrandir" class="modal-image" />
            </div>
        </div>
    }
</main>
