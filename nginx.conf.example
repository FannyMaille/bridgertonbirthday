# Configuration Nginx pour Blazor avec SignalR
# À placer dans /etc/nginx/sites-available/bridgerton-birthday.fr

server {
    listen 80;
    server_name bridgerton-birthday.fr www.bridgerton-birthday.fr;
    
    # Redirection HTTP vers HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bridgerton-birthday.fr www.bridgerton-birthday.fr;

    # Certificats SSL (à configurer avec Certbot/Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/bridgerton-birthday.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridgerton-birthday.fr/privkey.pem;

    # Configuration SSL recommandée
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Configuration des timeouts pour SignalR
    proxy_read_timeout 300s;
    proxy_connect_timeout 75s;
    proxy_send_timeout 300s;

    # Taille maximale des uploads
    client_max_body_size 10M;

    # Configuration pour les hubs SignalR (WebSocket)
    location /notificationHub {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        
        # Headers WebSocket essentiels
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Headers standard
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Désactiver le buffering pour les WebSockets
        proxy_buffering off;
        
        # Timeouts spécifiques pour WebSocket
        proxy_read_timeout 86400;
    }

    location /chatHub {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        
        # Headers WebSocket essentiels
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Headers standard
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Désactiver le buffering pour les WebSockets
        proxy_buffering off;
        
        # Timeouts spécifiques pour WebSocket
        proxy_read_timeout 86400;
    }

    # Configuration pour l'API REST
    location /api {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Configuration pour les fichiers statiques Blazor
    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Cache pour les fichiers statiques
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            proxy_pass http://localhost:5000;
            proxy_cache_valid 200 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
        }
    }

    # Logs
    access_log /var/log/nginx/bridgerton-birthday_access.log;
    error_log /var/log/nginx/bridgerton-birthday_error.log;
}
